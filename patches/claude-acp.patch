+import { describe, it, expect } from "vitest";
+import { snapshotFromRateLimit, summarizeUsage } from "../harness-usage.js";
+
+describe("summarizeUsage", () => {
+  it("keeps the five hour and seven day windows", () => {
+    const snapshot = summarizeUsage(
+      {
+        rate_limits: {
+          five_hour: { utilization: 38, resets_at: "2026-10-30T07:00:00Z" },
+          seven_day: { utilization: 12.5, resets_at: null },
+          seven_day_opus: { utilization: 1, resets_at: null },
+        },
+      },
+      1_793_300_000_000,
+    );
+    expect(snapshot).toEqual({
+      five_hour: { utilization: 38, resets_at: "2026-10-30T07:00:00Z" },
+      seven_day: { utilization: 12.5, resets_at: null },
+      updated: 1_793_300_000,
+    });
+  });
+
+  it("returns null without rate limits", () => {
+    expect(summarizeUsage({ rate_limits: null }, 0)).toBeNull();
+    expect(summarizeUsage(null, 0)).toBeNull();
+  });
+
+  it("treats missing windows as null", () => {
+    expect(summarizeUsage({ rate_limits: {} }, 0)).toEqual({
+      five_hour: null,
+      seven_day: null,
+      updated: 0,
+    });
+  });
+});
+
+describe("snapshotFromRateLimit", () => {
+  it("converts unified windows to percent and ISO reset times", () => {
+    const snapshot = snapshotFromRateLimit(
+      {
+        status: "allowed",
+        unifiedWindows: {
+          five_hour: { utilization: 0.75, resetsAt: 1_793_334_600, status: "allowed" },
+          seven_day: { utilization: 0.1, resetsAt: 1_793_527_200, status: "allowed" },
+        },
+      },
+      1_793_300_000_000,
+    );
+    expect(snapshot).toEqual({
+      five_hour: { utilization: 75, resets_at: "2026-10-30T04:30:00.000Z" },
+      seven_day: { utilization: 10, resets_at: "2026-11-01T10:00:00.000Z" },
+      updated: 1_793_300_000,
+    });
+  });
+
+  it("ignores events without unified windows", () => {
+    expect(snapshotFromRateLimit({ status: "allowed" }, 0)).toBeNull();
+  });
+});
