+/** 하네스 패치: 압축(compact)으로 끊긴 사슬까지 포함해 jsonl 전체 대화를 파일 순서대로 읽는다.
+ *  CLAUDE_ACP_FULL_HISTORY=1 일 때만 쓰고, 실패하면 SDK 기본 경로로 돌아간다. */
+export async function getFullSessionMessages(sessionId: string): Promise<SessionMessage[]> {
+  if (process.env.CLAUDE_ACP_FULL_HISTORY !== "1") return getSessionMessages(sessionId);
+  try {
+    const file = await findTranscript(sessionId);
+    if (!file) return getSessionMessages(sessionId);
+    const out: SessionMessage[] = [];
+    // 하네스 패치: jsonl 을 통째 문자열로 읽으면 큰 세션(>~512MB)에서 V8 "Invalid
+    // string length" 로 터진다. 반드시 line 단위 스트리밍으로 읽는다.
+    const rl = createInterface({
+      input: createReadStream(file, { encoding: "utf8" }),
+      crlfDelay: Infinity,
+    });
+    try {
+      for await (const line of rl) {
+        if (!line) continue;
+        let d: Record<string, unknown>;
+        try {
+          d = JSON.parse(line);
+        } catch {
+          continue;
+        }
+        if ((d.type !== "user" && d.type !== "assistant") || d.isSidechain === true) continue;
+        out.push({
+          type: d.type,
+          uuid: String(d.uuid ?? ""),
+          session_id: String(d.sessionId ?? sessionId),
+          message: d.message,
+          parent_tool_use_id: null,
+          parent_agent_id: null,
+          is_meta: d.isMeta === true,
+          origin: d.origin ?? null,
+        } as SessionMessage);
+      }
+    } finally {
+      rl.close();
+    }
+    return out.length > 0 ? out : getSessionMessages(sessionId);
+  } catch {
+    // 어떤 이유로든 실패하면 SDK 기본 경로로 안전하게 폴백.
+    return getSessionMessages(sessionId);
+  }
+}
