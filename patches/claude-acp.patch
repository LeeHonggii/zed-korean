+import { describe, expect, it } from "vitest";
+import { parseResetTime, resumeDelayMs } from "../harness-autoresume.js";
+
+describe("harness auto resume", () => {
+  const now = new Date(2026, 10, 1, 14, 20, 0);
+
+  it("reads the reset clock from the usage-limit text", () => {
+    const at = parseResetTime("You've hit your 5-hour limit · resets 3:40pm (Asia/Seoul)", now)!;
+    expect([at.getDate(), at.getHours(), at.getMinutes()]).toEqual([1, 15, 40]);
+  });
+
+  it("rolls past times to the next day and reads bare hours", () => {
+    const at = parseResetTime("resets 9am", now)!;
+    expect([at.getDate(), at.getHours()]).toEqual([2, 9]);
+  });
+
+  it("waits until reset plus a grace period, and gives up when unreadable or too far", () => {
+    expect(resumeDelayMs("resets 3:40pm", now)).toBe((80 * 60 + 90) * 1000);
+    expect(resumeDelayMs("limit reached", now)).toBeNull();
+    expect(resumeDelayMs("resets 1pm", now)).toBeNull();
+  });
+});
