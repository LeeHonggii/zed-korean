diff --git a/src/session-index/exclude-filter.ts b/src/session-index/exclude-filter.ts
new file mode 100644
index 0000000..77486f0
--- /dev/null
+++ b/src/session-index/exclude-filter.ts
@@ -0,0 +1,47 @@
+/**
+ * 하네스 패치: 세션 목록에서 자동화 세션(블로그 초안·논문 정제·Reflector·Curator·
+ * 로컬 커맨드 등)을 숨긴다. CLAUDE_ACP_HIDE_AUTOMATION=1 일 때만 적용한다.
+ * 패턴은 내장 기본값 + ~/.config/claude-acp/session-exclude.txt(한 줄 한 패턴, # 주석).
+ */
+
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+const DEFAULT_PATTERNS = [
+  "너는 AI 개발자 본인이 쓰는 기술 블로그",
+  "다음은 Gemma 가 추출한 논문 정보",
+  "# Reflector task",
+  "# Curator task",
+  "<local-command-caveat>",
+  "/usage",
+];
+
+let cached: string[] | undefined;
+
+function patterns(): string[] {
+  if (cached) return cached;
+  const list = [...DEFAULT_PATTERNS];
+  try {
+    const file = path.join(os.homedir(), ".config", "claude-acp", "session-exclude.txt");
+    for (const raw of fs.readFileSync(file, "utf8").split("\n")) {
+      const line = raw.trim();
+      if (line && !line.startsWith("#")) list.push(line);
+    }
+  } catch {
+    // 파일이 없으면 기본값만 쓴다.
+  }
+  cached = list;
+  return cached;
+}
+
+export function isAutomationHidden(): boolean {
+  return process.env.CLAUDE_ACP_HIDE_AUTOMATION === "1";
+}
+
+/** 세션 제목(미rename 세션은 첫 프롬프트)이 숨길 자동화 패턴에 걸리는가. */
+export function isExcludedTitle(title: string | undefined): boolean {
+  if (!title) return false;
+  const t = title.trim();
+  return patterns().some((p) => t.includes(p));
+}
