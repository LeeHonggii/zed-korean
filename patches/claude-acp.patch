@@ -0,0 +1,92 @@
+import { mkdir, rename, writeFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import { dirname, join } from "node:path";
+import type { Query } from "@anthropic-ai/claude-agent-sdk";
+
+const MIN_INTERVAL_MS = 60_000;
+const TIMEOUT_MS = 10_000;
+let lastRecordedAt = 0;
+
+type Window = { utilization: number | null; resets_at: string | null } | null;
+
+export type ClaudeUsageSnapshot = {
+  five_hour: Window;
+  seven_day: Window;
+  updated: number;
+};
+
+export function usageFile(): string {
+  return process.env.CLAUDE_ACP_USAGE_FILE ?? join(homedir(), ".harness", "usage", "claude.json");
+}
+
+/** 하네스 패치: SDK 사용량 응답에서 5시간·7일 창만 뽑는다(없으면 null). */
+export function summarizeUsage(usage: unknown, now: number): ClaudeUsageSnapshot | null {
+  const limits = (usage as { rate_limits?: Record<string, unknown> } | null)?.rate_limits;
+  if (!limits || typeof limits !== "object") return null;
+  const pick = (value: unknown): Window => {
+    if (!value || typeof value !== "object") return null;
+    const window = value as { utilization?: unknown; resets_at?: unknown };
+    return {
+      utilization: typeof window.utilization === "number" ? window.utilization : null,
+      resets_at: typeof window.resets_at === "string" ? window.resets_at : null,
+    };
+  };
+  return { five_hour: pick(limits.five_hour), seven_day: pick(limits.seven_day), updated: now / 1000 };
+}
+
+/** 하네스 패치: 턴이 끝나면 Claude 구독 사용량을 파일로 남겨 Zed 타이틀바가 읽게 한다(1분에 한 번까지). */
+export async function recordClaudeUsage(query: Query | undefined): Promise<void> {
+  if (!query || process.env.CLAUDE_ACP_HIDE_USAGE === "1") return;
+  const now = Date.now();
+  if (now - lastRecordedAt < MIN_INTERVAL_MS) return;
+  lastRecordedAt = now;
+  try {
+    const usage = await Promise.race([
+      query.usage_EXPERIMENTAL_MAY_CHANGE_DO_NOT_RELY_ON_THIS_API_YET(),
+      new Promise<never>((_, reject) =>
+        setTimeout(() => reject(new Error("usage timeout")), TIMEOUT_MS),
+      ),
+    ]);
+    const snapshot = summarizeUsage(usage, now);
+    if (!snapshot) return;
+    await writeSnapshot(snapshot);
+  } catch {
+    lastRecordedAt = 0;
+  }
+}
+
+/** 하네스 패치: 매 응답의 rate_limit_event(unifiedWindows)를 사용량 스냅샷으로 바꾼다. */
+export function snapshotFromRateLimit(info: unknown, now: number): ClaudeUsageSnapshot | null {
+  const windows = (info as { unifiedWindows?: Record<string, unknown> } | null)?.unifiedWindows;
+  if (!windows || typeof windows !== "object") return null;
+  const pick = (value: unknown): Window => {
+    if (!value || typeof value !== "object") return null;
+    const window = value as { utilization?: unknown; resetsAt?: unknown };
+    return {
+      utilization: typeof window.utilization === "number" ? window.utilization * 100 : null,
+      resets_at:
+        typeof window.resetsAt === "number" ? new Date(window.resetsAt * 1000).toISOString() : null,
+    };
+  };
+  return { five_hour: pick(windows.five_hour), seven_day: pick(windows.seven_day), updated: now / 1000 };
+}
+
+async function writeSnapshot(snapshot: ClaudeUsageSnapshot): Promise<void> {
+  const file = usageFile();
+  await mkdir(dirname(file), { recursive: true });
+  const tmp = `${file}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(snapshot));
+  await rename(tmp, file);
+}
+
+/** 하네스 패치: 응답마다 오는 사용량 이벤트를 바로 파일로 남긴다(추가 요청 없음). */
+export async function recordRateLimitInfo(info: unknown): Promise<void> {
+  if (process.env.CLAUDE_ACP_HIDE_USAGE === "1") return;
+  const snapshot = snapshotFromRateLimit(info, Date.now());
+  if (!snapshot) return;
+  try {
+    await writeSnapshot(snapshot);
+  } catch {
+    return;
+  }
+}
