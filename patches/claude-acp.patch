diff --git a/src/harness-activity.ts b/src/harness-activity.ts
new file mode 100644
index 0000000..a564440
--- /dev/null
+++ b/src/harness-activity.ts
@@ -0,0 +1,88 @@
+import type { AcpSessionNotification } from "./acp-subagents.js";
+
+type Publish = (update: AcpSessionNotification["update"]) => Promise<void>;
+
+const HOOK_SHOW_AFTER_MS = 1500;
+
+/** 하네스 패치: 백그라운드 작업·오래 걸리는 훅을 진행 중 tool call 카드로 보여 준다(Zed 등 AIR 미지원 클라이언트용). */
+export class HarnessActivity {
+  private readonly descriptions = new Map<string, string>();
+  private readonly shownTasks = new Set<string>();
+  private readonly hooks = new Map<string, { timer?: ReturnType<typeof setTimeout>; shown: boolean }>();
+
+  constructor(private readonly publish: Publish) {}
+
+  static enabled(): boolean {
+    return process.env.CLAUDE_ACP_HIDE_BACKGROUND !== "1";
+  }
+
+  async taskStarted(taskId: string, description: string, backgrounded: boolean | undefined) {
+    this.descriptions.set(taskId, description);
+    if (backgrounded) await this.showTask(taskId);
+  }
+
+  async taskBackgrounded(taskId: string, description?: string) {
+    if (description) this.descriptions.set(taskId, description);
+    await this.showTask(taskId);
+  }
+
+  async taskEnded(taskId: string, status: string) {
+    this.descriptions.delete(taskId);
+    if (!this.shownTasks.delete(taskId)) return;
+    await this.send({
+      sessionUpdate: "tool_call_update",
+      toolCallId: `bgtask-${taskId}`,
+      status: status === "completed" ? "completed" : "failed",
+    });
+  }
+
+  hookStarted(hookId: string, hookName: string, hookEvent: string) {
+    const entry: { timer?: ReturnType<typeof setTimeout>; shown: boolean } = { shown: false };
+    entry.timer = setTimeout(() => {
+      entry.shown = true;
+      const label =
+        hookName && hookName !== hookEvent ? `${hookEvent} (${hookName})` : hookEvent;
+      void this.send(this.card(`hook-${hookId}`, `훅 실행 중: ${label}`));
+    }, HOOK_SHOW_AFTER_MS);
+    this.hooks.set(hookId, entry);
+  }
+
+  async hookEnded(hookId: string, outcome: string) {
+    const entry = this.hooks.get(hookId);
+    if (!entry) return;
+    this.hooks.delete(hookId);
+    if (entry.timer) clearTimeout(entry.timer);
+    if (!entry.shown) return;
+    await this.send({
+      sessionUpdate: "tool_call_update",
+      toolCallId: `hook-${hookId}`,
+      status: outcome === "success" ? "completed" : "failed",
+    });
+  }
+
+  private async showTask(taskId: string) {
+    if (this.shownTasks.has(taskId)) return;
+    this.shownTasks.add(taskId);
+    const description = this.descriptions.get(taskId) || "작업";
+    await this.send(this.card(`bgtask-${taskId}`, `백그라운드: ${description}`));
+  }
+
+  private card(toolCallId: string, title: string): AcpSessionNotification["update"] {
+    return {
+      sessionUpdate: "tool_call",
+      toolCallId,
+      title,
+      kind: "other",
+      status: "in_progress",
+      rawInput: { description: title },
+    } as AcpSessionNotification["update"];
+  }
+
+  private async send(update: AcpSessionNotification["update"]) {
+    try {
+      await this.publish(update);
+    } catch {
+      return;
+    }
+  }
+}
diff --git a/src/harness-bash.ts b/src/harness-bash.ts
new file mode 100644
index 0000000..ead18a3
--- /dev/null
+++ b/src/harness-bash.ts
@@ -0,0 +1,87 @@
+import { spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import type { AcpSessionNotification } from "./acp-subagents.js";
+
+type Publish = (update: AcpSessionNotification["update"]) => Promise<void>;
+
+const MAX_OUTPUT = 200_000;
+const MAX_CONTEXT = 20_000;
+const TIMEOUT_MS = 10 * 60 * 1000;
+
+/** 하네스 패치: `!명령`이면 그 명령 문자열, 아니면 undefined. */
+export function bangCommand(prompt: unknown): string | undefined {
+  if (!Array.isArray(prompt) || prompt.length !== 1) return undefined;
+  const block = prompt[0] as { type?: string; text?: string };
+  if (block?.type !== "text" || typeof block.text !== "string") return undefined;
+  const text = block.text.trim();
+  if (!text.startsWith("!")) return undefined;
+  const command = text.slice(1).trim();
+  return command.length > 0 ? command : undefined;
+}
+
+/** 하네스 패치: 모델을 거치지 않고 사용자가 친 셸 명령을 바로 실행하고, 다음 메시지에 붙일 기록을 돌려준다. */
+export async function runBangCommand(
+  command: string,
+  cwd: string,
+  publish: Publish,
+): Promise<string> {
+  const toolCallId = `bang-${randomUUID()}`;
+  await publish({
+    sessionUpdate: "tool_call",
+    toolCallId,
+    title: command,
+    kind: "execute",
+    status: "in_progress",
+    rawInput: { command, description: `직접 실행: ${command}` },
+  } as AcpSessionNotification["update"]);
+
+  const { stdout, stderr, code } = await new Promise<{
+    stdout: string;
+    stderr: string;
+    code: number | null;
+  }>((resolve) => {
+    let out = "";
+    let err = "";
+    const child = spawn("/bin/zsh", ["-lc", command], { cwd, env: process.env });
+    const timer = setTimeout(() => child.kill("SIGTERM"), TIMEOUT_MS);
+    child.stdout.on("data", (chunk) => {
+      if (out.length < MAX_OUTPUT) out += chunk.toString();
+    });
+    child.stderr.on("data", (chunk) => {
+      if (err.length < MAX_OUTPUT) err += chunk.toString();
+    });
+    child.on("error", (error) => {
+      clearTimeout(timer);
+      resolve({ stdout: out, stderr: err + String(error), code: 1 });
+    });
+    child.on("close", (exitCode) => {
+      clearTimeout(timer);
+      resolve({ stdout: out, stderr: err, code: exitCode });
+    });
+  });
+
+  const shown = [stdout, stderr].filter((part) => part.trim()).join("\n").trimEnd();
+  await publish({
+    sessionUpdate: "tool_call_update",
+    toolCallId,
+    status: code === 0 ? "completed" : "failed",
+    content: [
+      {
+        type: "content",
+        content: {
+          type: "text",
+          text: "```\n" + (shown || "(출력 없음)") + `\n\`\`\`\n종료 코드 ${code ?? "?"}`,
+        },
+      },
+    ],
+    rawOutput: { stdout, stderr, exitCode: code },
+  } as AcpSessionNotification["update"]);
+
+  const clip = (text: string) =>
+    text.length > MAX_CONTEXT ? text.slice(0, MAX_CONTEXT) + "\n…(잘림)" : text;
+  return (
+    `<bash-input>${command}</bash-input>\n` +
+    `<bash-stdout>${clip(stdout)}</bash-stdout>\n` +
+    `<bash-stderr>${clip(stderr)}</bash-stderr>\n`
+  );
+}
