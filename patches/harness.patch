+        if running.is_empty() && agents.is_empty() && self.status() == ThreadStatus::Generating {
+            running.push(match last_done_title {
+                Some(title) => format!("◐ 답변 작성 중 · 직전: {title}"),
+                None => "◐ 답변 작성 중".to_string(),
+            });
+        }
+        if !running.is_empty() || !done.is_empty() {
+            let mut parts = running;
+            parts.extend(done.into_iter().map(|(label, count)| {
+                if count > 1 {
+                    format!("✓ {label} ×{count}")
+                } else {
+                    format!("✓ {label}")
+                }
+            }));
+            lines.push(parts.join(" | ").into());
