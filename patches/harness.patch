+// 하네스 패치: 셸 heredoc(python3 - <<'EOF' … EOF) 본문을 그 언어 문법 색으로 칠한다.
+const HEREDOC_LANGUAGES: [(&str, &str); 5] = [
+    ("python", "py"),
+    ("node", "js"),
+    ("ruby", "rb"),
+    ("sqlite3", "sql"),
+    ("psql", "sql"),
+];
+
+fn heredoc_language_for(command: &str) -> Option<&'static str> {
+    let word = command.split_whitespace().find(|word| !word.contains('='))?;
+    let base = word.rsplit('/').next().unwrap_or(word);
+    HEREDOC_LANGUAGES
+        .iter()
+        .find(|(prefix, _)| base.starts_with(prefix))
+        .map(|(_, language)| *language)
+}
+
+fn heredoc_segments(text: &str) -> Vec<(Range<usize>, &'static str)> {
+    let mut segments = Vec::new();
+    let mut offset = 0;
+    let mut open: Option<(&'static str, String, usize)> = None;
+    for line in text.split_inclusive('\n') {
+        let line_start = offset;
+        offset += line.len();
+        let content = line.trim_end_matches(['\n', '\r']);
+        if let Some((language, delimiter, body_start)) = &open {
+            if content.trim() == delimiter {
+                if line_start > *body_start {
+                    segments.push((*body_start..line_start, *language));
+                }
+                open = None;
+            }
+            continue;
+        }
+        let Some(position) = content.find("<<") else {
+            continue;
+        };
+        let after = content[position + 2..].trim_start_matches('-').trim_start();
+        let delimiter: String = after
+            .trim_start_matches(['\'', '"'])
+            .chars()
+            .take_while(|c| c.is_alphanumeric() || *c == '_')
+            .collect();
+        if delimiter.is_empty() {
+            continue;
+        }
+        let head = &content[..position];
+        let command = head.rsplit([';', '|', '&']).next().unwrap_or(head);
+        if let Some(language) = heredoc_language_for(command) {
+            open = Some((language, delimiter, offset));
+        }
+    }
+    if let Some((language, _, body_start)) = open
+        && offset > body_start
+    {
+        segments.push((body_start..offset, language));
+    }
+    segments
+}
+
+fn heredoc_language_names(source: &str) -> impl Iterator<Item = &'static str> {
+    let mut names: Vec<&'static str> = heredoc_segments(source)
+        .into_iter()
+        .map(|(_, language)| language)
+        .collect();
+    names.sort_unstable();
+    names.dedup();
+    names.into_iter()
+}
+
+fn highlight_heredocs(
+    resolved: ResolvedHighlights,
+    text: &str,
+    languages_by_name: &TreeMap<SharedString, Arc<Language>>,
+) -> ResolvedHighlights {
+    let segments: Vec<_> = heredoc_segments(text)
+        .into_iter()
+        .filter_map(|(range, name)| {
+            languages_by_name
+                .get(&SharedString::from(name))
+                .cloned()
+                .map(|language| (range, language))
+        })
+        .collect();
+    if segments.is_empty() {
+        return resolved;
+    }
+    let mut sources = resolved.sources.clone();
+    let mut runs: Vec<(Range<usize>, HighlightId)> = Vec::new();
+    for (range, id) in resolved.runs.iter() {
+        let mut pieces = vec![range.clone()];
+        for (segment, _) in &segments {
+            pieces = pieces
+                .into_iter()
+                .flat_map(|piece| {
+                    let mut kept = Vec::new();
+                    if piece.start < segment.start {
+                        kept.push(piece.start..piece.end.min(segment.start));
+                    }
+                    if piece.end > segment.end {
+                        kept.push(piece.start.max(segment.end)..piece.end);
+                    }
+                    kept
+                })
+                .filter(|piece| piece.start < piece.end)
+                .collect();
+        }
+        runs.extend(pieces.into_iter().map(|piece| (piece, *id)));
+    }
+    for (segment, language) in segments {
+        let inner = language
+            .highlight_text_resolved(&Rope::from(&text[segment.clone()]), 0..segment.len());
+        for source in inner.sources.iter() {
+            if !sources
+                .iter()
+                .any(|(grammar, _)| Arc::ptr_eq(grammar, &source.0))
+            {
+                sources.push(source.clone());
+            }
+        }
+        runs.extend(
+            inner
+                .runs
+                .iter()
+                .map(|(range, id)| (range.start + segment.start..range.end + segment.start, *id)),
+        );
+    }
+    runs.sort_by_key(|(range, _)| range.start);
+    ResolvedHighlights {
+        sources,
+        runs: runs.into(),
+    }
+}
