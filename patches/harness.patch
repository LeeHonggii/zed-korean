+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use chrono::{DateTime, Local, NaiveDate};
+use serde_json::Value;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct UsageChip {
+    pub name: &'static str,
+    pub remaining_percent: Option<f64>,
+    pub resets_in: Option<Duration>,
+    pub note: Option<String>,
+}
+
+impl UsageChip {
+    fn empty(name: &'static str) -> Self {
+        Self {
+            name,
+            remaining_percent: None,
+            resets_in: None,
+            note: None,
+        }
+    }
+
+    pub fn label(&self) -> String {
+        let mut parts = Vec::new();
+        match (self.remaining_percent, &self.note) {
+            (Some(percent), _) => parts.push(format!("{}%", percent.round() as i64)),
+            (None, Some(note)) => parts.push(note.clone()),
+            (None, None) => parts.push("—".to_string()),
+        }
+        if let Some(duration) = self.resets_in {
+            parts.push(format_duration(duration));
+        }
+        format!("{} {}", self.name, parts.join(" · "))
+    }
+}
+
+pub fn format_duration(duration: Duration) -> String {
+    let minutes = duration.as_secs() / 60;
+    let (hours, minutes) = (minutes / 60, minutes % 60);
+    match (hours / 24, hours % 24) {
+        (0, 0) => format!("{minutes}분"),
+        (0, hours) => format!("{hours}시간{minutes:02}분"),
+        (days, hours) => format!("{days}일{hours}시간"),
+    }
+}
+
+fn epoch_seconds(time: SystemTime) -> f64 {
+    time.duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs_f64())
+        .unwrap_or_default()
+}
+
+fn until(reset_epoch: f64, now: SystemTime) -> Option<Duration> {
+    let left = reset_epoch - epoch_seconds(now);
+    (left > 0.).then(|| Duration::from_secs_f64(left))
+}
+
+fn window_chip(
+    name: &'static str,
+    used_percent: Option<f64>,
+    reset_epoch: Option<f64>,
+    now: SystemTime,
+) -> UsageChip {
+    let mut chip = UsageChip::empty(name);
+    let resets_in = reset_epoch.and_then(|epoch| until(epoch, now));
+    if reset_epoch.is_some() && resets_in.is_none() {
+        chip.remaining_percent = Some(100.);
+        return chip;
+    }
+    chip.remaining_percent = used_percent.map(|used| (100. - used).clamp(0., 100.));
+    chip.resets_in = resets_in;
+    chip
+}
+
+pub fn claude_chip(path: &Path, now: SystemTime) -> UsageChip {
+    let Some(value) = std::fs::read_to_string(path)
+        .ok()
+        .and_then(|text| serde_json::from_str::<Value>(&text).ok())
+    else {
+        return UsageChip::empty("Claude");
+    };
+    let window = &value["five_hour"];
+    let reset = window["resets_at"]
+        .as_str()
+        .and_then(|text| DateTime::parse_from_rfc3339(text).ok())
+        .map(|time| time.timestamp() as f64);
+    window_chip("Claude", window["utilization"].as_f64(), reset, now)
+}
+
+fn latest_codex_rollout(sessions: &Path) -> Option<PathBuf> {
+    let mut newest: Option<(SystemTime, PathBuf)> = None;
+    let mut stack = vec![sessions.to_path_buf()];
+    let mut depth_limit = 4usize;
+    while let Some(dir) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        let mut subdirs: Vec<PathBuf> = Vec::new();
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.is_dir() {
+                subdirs.push(path);
+            } else if path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .is_some_and(|name| name.starts_with("rollout-") && name.ends_with(".jsonl"))
+            {
+                let modified = entry
+                    .metadata()
+                    .and_then(|meta| meta.modified())
+                    .unwrap_or(UNIX_EPOCH);
+                if newest.as_ref().is_none_or(|(time, _)| modified > *time) {
+                    newest = Some((modified, path));
+                }
+            }
+        }
+        if depth_limit > 0 {
+            subdirs.sort();
+            if let Some(last) = subdirs.pop() {
+                stack.push(last);
+            }
+            depth_limit -= 1;
+        }
+    }
+    newest.map(|(_, path)| path)
+}
+
+pub fn codex_chip(sessions: &Path, now: SystemTime) -> UsageChip {
+    let Some(text) = latest_codex_rollout(sessions).and_then(|path| std::fs::read_to_string(path).ok())
+    else {
+        return UsageChip::empty("GPT");
+    };
+    let limits = text.lines().rev().find_map(|line| {
+        if !line.contains("\"rate_limits\"") {
+            return None;
+        }
+        let value: Value = serde_json::from_str(line).ok()?;
+        find_key(&value, "rate_limits").filter(|limits| limits["primary"].is_object())
+    });
+    let Some(limits) = limits else {
+        return UsageChip::empty("GPT");
+    };
+    let primary = &limits["primary"];
+    window_chip(
+        "GPT",
+        primary["used_percent"].as_f64(),
+        primary["resets_at"].as_f64(),
+        now,
+    )
+}
+
+fn find_key(value: &Value, key: &str) -> Option<Value> {
+    match value {
+        Value::Object(map) => map
+            .get(key)
+            .cloned()
+            .or_else(|| map.values().find_map(|child| find_key(child, key))),
+        Value::Array(items) => items.iter().find_map(|child| find_key(child, key)),
+        _ => None,
+    }
+}
+
+pub fn jev_chip(path: &Path, today: NaiveDate) -> UsageChip {
+    let mut chip = UsageChip::empty("Jev");
+    let Ok(text) = std::fs::read_to_string(path) else {
+        return chip;
+    };
+    let mut tokens = 0u64;
+    for line in text.lines() {
+        let Ok(value) = serde_json::from_str::<Value>(line) else {
+            continue;
+        };
+        let same_day = value["ts"]
+            .as_str()
+            .and_then(|ts| DateTime::parse_from_rfc3339(ts).ok())
+            .is_some_and(|time| time.with_timezone(&Local).date_naive() == today);
+        if same_day {
+            tokens += value["input_tokens"].as_u64().unwrap_or(0)
+                + value["output_tokens"].as_u64().unwrap_or(0);
+        }
+    }
+    chip.note = Some(format!("오늘 {}", format_tokens(tokens)));
+    chip
+}
+
+fn format_tokens(tokens: u64) -> String {
+    if tokens >= 1_000_000 {
+        format!("{:.1}M토큰", tokens as f64 / 1_000_000.)
+    } else if tokens >= 1_000 {
+        format!("{:.1}k토큰", tokens as f64 / 1_000.)
+    } else {
+        format!("{tokens}토큰")
+    }
+}
+
+pub fn snapshot(now: SystemTime) -> Vec<UsageChip> {
+    let Some(home) = std::env::var_os("HOME").map(PathBuf::from) else {
+        return Vec::new();
+    };
+    vec![
+        claude_chip(&home.join(".harness/usage/claude.json"), now),
+        codex_chip(&home.join(".codex/sessions"), now),
+        jev_chip(&home.join(".harness/usage/jev.jsonl"), Local::now().date_naive()),
+    ]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn at(epoch: u64) -> SystemTime {
+        UNIX_EPOCH + Duration::from_secs(epoch)
+    }
+
+    #[test]
+    fn claude_remaining_and_reset() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("claude.json");
+        std::fs::write(
+            &path,
+            r#"{"five_hour":{"utilization":75,"resets_at":"2026-10-30T04:30:00.000Z"},"seven_day":null,"updated":1}"#,
+        )
+        .unwrap();
+        let reset = DateTime::parse_from_rfc3339("2026-10-30T04:30:00Z").unwrap().timestamp() as u64;
+        let chip = claude_chip(&path, at(reset - 3 * 3600 - 12 * 60));
+        assert_eq!(chip.remaining_percent, Some(25.));
+        assert_eq!(chip.label(), "Claude 25% · 3시간12분");
+        let after = claude_chip(&path, at(reset + 10));
+        assert_eq!(after.label(), "Claude 100%");
+        assert_eq!(claude_chip(&dir.path().join("none.json"), at(0)).label(), "Claude —");
+    }
+
+    #[test]
+    fn codex_reads_latest_rollout_rate_limits() {
+        let dir = tempfile::tempdir().unwrap();
+        let day = dir.path().join("2026/10/30");
+        std::fs::create_dir_all(&day).unwrap();
