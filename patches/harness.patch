+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct WorldRect {
+    pub x: f64,
+    pub y: f64,
+    pub w: f64,
+    pub h: f64,
+}
+
+impl WorldRect {
+    pub fn from_corners(a: (f64, f64), b: (f64, f64)) -> Self {
+        let x = snap(a.0.min(b.0));
+        let y = snap(a.1.min(b.1));
+        Self {
+            x,
+            y,
+            w: snap((a.0 - b.0).abs()),
+            h: snap((a.1 - b.1).abs()),
+        }
+    }
+
+    fn contains(&self, x: f64, y: f64) -> bool {
+        x >= self.x && x <= self.x + self.w && y >= self.y && y <= self.y + self.h
+    }
+
+    fn center(&self) -> (f64, f64) {
+        (self.x + self.w / 2., self.y + self.h / 2.)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NodeKind {
+    Group,
+    Text,
+    File,
+}
+
+#[derive(Clone, Debug)]
+pub struct Node {
+    pub id: String,
+    pub kind: NodeKind,
+    pub rect: WorldRect,
+    pub text: String,
+    pub color: Option<String>,
+    raw: Map<String, Value>,
+}
+
+impl Node {
+    pub fn editable_text(&self) -> String {
+        self.text.clone()
+    }
+
+    pub fn set_editable_text(&mut self, text: &str) {
+        self.text = text.to_string();
+    }
+
+    pub fn set_color(&mut self, color: Option<&str>) {
+        self.color = color.map(str::to_string);
+    }
+
+    pub fn is_image(&self) -> bool {
+        let body = self.text.trim();
+        self.kind == NodeKind::Text && (body == "이미지" || body.starts_with("이미지:"))
+    }
+
+    fn to_value(&self) -> Value {
+        let mut map = self.raw.clone();
+        map.insert("id".into(), json!(self.id));
+        map.insert(
+            "type".into(),
+            json!(match self.kind {
+                NodeKind::Group => "group",
+                NodeKind::Text => "text",
+                NodeKind::File => "file",
+            }),
+        );
+        map.insert("x".into(), number(self.rect.x));
+        map.insert("y".into(), number(self.rect.y));
+        map.insert("width".into(), number(self.rect.w));
+        map.insert("height".into(), number(self.rect.h));
+        let text_key = match self.kind {
+            NodeKind::Group => "label",
+            NodeKind::Text => "text",
+            NodeKind::File => "file",
+        };
+        map.insert(text_key.into(), json!(self.text));
+        match &self.color {
+            Some(color) => map.insert("color".into(), json!(color)),
+            None => map.remove("color"),
+        };
+        Value::Object(map)
+    }
+}
+
+#[derive(Default, Debug)]
+pub struct CanvasDoc {
+    pub nodes: Vec<Node>,
+    others: Vec<Value>,
+    root: Map<String, Value>,
+}
+
+impl CanvasDoc {
+    pub fn parse(text: &str) -> anyhow::Result<Self> {
+        if text.trim().is_empty() {
+            return Ok(Self::default());
+        }
+        let Value::Object(root) = serde_json::from_str::<Value>(text)? else {
+            anyhow::bail!("최상위가 객체가 아님");
+        };
+        let mut nodes = Vec::new();
+        let mut others = Vec::new();
+        for value in root
+            .get("nodes")
+            .and_then(Value::as_array)
+            .cloned()
+            .unwrap_or_default()
+        {
+            match node_from_value(&value) {
+                Some(node) => nodes.push(node),
+                None => others.push(value),
+            }
+        }
+        Ok(Self {
+            nodes,
+            others,
+            root,
+        })
+    }
+
+    pub fn to_text(&self) -> String {
+        let mut root = self.root.clone();
+        let mut values: Vec<Value> = self.nodes.iter().map(Node::to_value).collect();
+        values.extend(self.others.iter().cloned());
+        root.insert("nodes".into(), Value::Array(values));
+        root.entry("edges").or_insert_with(|| json!([]));
+        let mut out = Vec::new();
+        let formatter = serde_json::ser::PrettyFormatter::with_indent(b"\t");
+        let mut serializer = serde_json::Serializer::with_formatter(&mut out, formatter);
+        serde::Serialize::serialize(&Value::Object(root), &mut serializer)
+            .expect("json 직렬화는 실패하지 않음");
+        String::from_utf8(out).unwrap_or_default()
+    }
+
+    pub fn index_of(&self, id: &str) -> Option<usize> {
+        self.nodes.iter().position(|node| node.id == id)
+    }
+
+    pub fn hit_content(&self, x: f64, y: f64) -> Option<usize> {
+        self.nodes
+            .iter()
+            .enumerate()
+            .rev()
+            .find(|(_, node)| node.kind != NodeKind::Group && node.rect.contains(x, y))
+            .map(|(index, _)| index)
+    }
+
+    pub fn children_of(&self, group: usize) -> Vec<usize> {
+        let frame = self.nodes[group].rect;
+        self.nodes
+            .iter()
+            .enumerate()
+            .filter(|(index, node)| {
+                *index != group && node.kind != NodeKind::Group && {
+                    let (cx, cy) = node.rect.center();
+                    frame.contains(cx, cy)
+                }
+            })
+            .map(|(index, _)| index)
+            .collect()
+    }
+
+    pub fn extent(&self) -> Option<WorldRect> {
+        let first = self.nodes.first()?.rect;
+        let (mut x0, mut y0) = (first.x, first.y);
+        let (mut x1, mut y1) = (first.x + first.w, first.y + first.h);
+        for node in &self.nodes {
+            x0 = x0.min(node.rect.x);
+            y0 = y0.min(node.rect.y);
+            x1 = x1.max(node.rect.x + node.rect.w);
+            y1 = y1.max(node.rect.y + node.rect.h);
+        }
+        Some(WorldRect {
+            x: x0,
+            y: y0,
+            w: (x1 - x0).max(1.),
+            h: (y1 - y0).max(1.),
+        })
+    }
+
+    pub fn add_text(&mut self, rect: WorldRect) -> String {
+        let id = new_id(self.nodes.len());
+        self.nodes.push(Node {
+            id: id.clone(),
+            kind: NodeKind::Text,
+            rect,
+            text: String::new(),
+            color: None,
+            raw: Map::new(),
+        });
+        id
+    }
+
+    pub fn add_slide(&mut self) -> String {
+        let groups: Vec<WorldRect> = self
+            .nodes
+            .iter()
+            .filter(|node| node.kind == NodeKind::Group)
+            .map(|node| node.rect)
+            .collect();
+        let x = groups.iter().map(|r| r.x).fold(f64::INFINITY, f64::min);
+        let bottom = groups
+            .iter()
+            .map(|r| r.y + r.h)
+            .fold(f64::NEG_INFINITY, f64::max);
+        let (x, y) = if groups.is_empty() {
+            (0., 0.)
+        } else {
+            (x, bottom + SLIDE_GAP)
+        };
+        let id = new_id(self.nodes.len());
+        self.nodes.push(Node {
+            id: id.clone(),
+            kind: NodeKind::Group,
+            rect: WorldRect {
+                x,
+                y,
+                w: SLIDE_W,
+                h: SLIDE_H,
+            },
+            text: "새 슬라이드".into(),
+            color: None,
+            raw: Map::new(),
+        });
+        id
+    }
+
+    pub fn remove(&mut self, id: &str) {
+        self.nodes.retain(|node| node.id != id);
+    }
+}
+
+fn node_from_value(value: &Value) -> Option<Node> {
+    let map = value.as_object()?;
+    let kind = match map.get("type")?.as_str()? {
+        "group" => NodeKind::Group,
+        "text" => NodeKind::Text,
+        "file" => NodeKind::File,
+        _ => return None,
+    };
+    let get = |key: &str| map.get(key).and_then(Value::as_f64);
+    let text_key = match kind {
+        NodeKind::Group => "label",
+        NodeKind::Text => "text",
+        NodeKind::File => "file",
+    };
+    Some(Node {
+        id: map.get("id")?.as_str()?.to_string(),
+        kind,
+        rect: WorldRect {
+            x: get("x")?,
+            y: get("y")?,
+            w: get("width")?,
+            h: get("height")?,
+        },
+        text: map
+            .get(text_key)
+            .and_then(Value::as_str)
+            .unwrap_or_default()
+            .to_string(),
+        color: map.get("color").and_then(Value::as_str).map(str::to_string),
+        raw: map.clone(),
+    })
+}
+
+fn number(value: f64) -> Value {
+    if value.fract() == 0. && value.abs() < 1e15 {
+        json!(value as i64)
+    } else {
+        json!(value)
+    }
+}
+
+fn new_id(salt: usize) -> String {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_nanos())
+        .unwrap_or_default();
+    format!("{:016x}", (nanos as u64) ^ ((salt as u64) << 48))
+}
+
+pub fn snap(value: f64) -> f64 {
+    (value / GRID).round() * GRID
+}
+
+pub fn parse_hex(hex: &str) -> Option<u32> {
+    let digits = hex.trim().trim_start_matches('#');
+    let digits = match digits.len() {
+        3 => digits.chars().flat_map(|c| [c, c]).collect::<String>(),
+        6 => digits.to_string(),
+        _ => return None,
+    };
+    u32::from_str_radix(&digits, 16).ok()
+}
+
+pub fn resolve_color(color: &str) -> Option<u32> {
+    let preset = OBSIDIAN_COLORS
+        .iter()
+        .find(|(key, _)| *key == color)
+        .map(|(_, hex)| *hex);
+    parse_hex(preset.unwrap_or(color))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SAMPLE: &str = r##"{"nodes":[
+ {"id":"g1","type":"group","x":0,"y":0,"width":1600,"height":900,"label":"제목","color":"4"},
+ {"id":"b1","type":"text","x":100,"y":320,"width":680,"height":280,"text":"내용","styleAttributes":{}},
+ {"id":"f1","type":"file","x":900,"y":320,"width":300,"height":200,"file":"chart.png"},
+ {"id":"l1","type":"link","x":0,"y":2000,"width":10,"height":10,"url":"https://a"}
+],"edges":[{"id":"e1","fromNode":"g1","toNode":"b1"}]}"##;
+
+    #[test]
+    fn round_trip_keeps_unknown_fields_and_nodes() {
+        let doc = CanvasDoc::parse(SAMPLE).unwrap();
+        assert_eq!(doc.nodes.len(), 3);
+        let text = doc.to_text();
+        let again: Value = serde_json::from_str(&text).unwrap();
+        assert_eq!(again["nodes"].as_array().unwrap().len(), 4);
+        assert_eq!(again["nodes"][1]["styleAttributes"], json!({}));
+        assert_eq!(again["nodes"][3]["url"], json!("https://a"));
+        assert_eq!(again["edges"][0]["id"], json!("e1"));
+        assert_eq!(again["nodes"][0]["label"], json!("제목"));
+        assert_eq!(again["nodes"][0]["x"], json!(0));
+    }
+
+    #[test]
+    fn moving_group_moves_children_only() {
+        let doc = CanvasDoc::parse(SAMPLE).unwrap();
+        assert_eq!(doc.children_of(0), vec![1, 2]);
+    }
+
+    #[test]
+    fn hit_prefers_content_over_group() {
+        let doc = CanvasDoc::parse(SAMPLE).unwrap();
+        assert_eq!(doc.hit_content(200., 400.), Some(1));
+        assert_eq!(doc.hit_content(50., 50.), None);
+    }
+
+    #[test]
+    fn new_slide_goes_below_last_slide() {
+        let mut doc = CanvasDoc::parse(SAMPLE).unwrap();
+        let id = doc.add_slide();
+        let node = &doc.nodes[doc.index_of(&id).unwrap()];
+        assert_eq!(node.rect, WorldRect { x: 0., y: 1050., w: 1600., h: 900. });
+        let mut empty = CanvasDoc::parse("").unwrap();
+        empty.add_slide();
+        assert_eq!(empty.nodes[0].rect.y, 0.);
+    }
+
+    #[test]
+    fn color_edit_and_removal() {
+        let mut doc = CanvasDoc::parse(SAMPLE).unwrap();
+        doc.nodes[0].set_color(None);
+        doc.nodes[1].set_color(Some("#dc2626"));
+        let again: Value = serde_json::from_str(&doc.to_text()).unwrap();
+        assert!(again["nodes"][0].get("color").is_none());
+        assert_eq!(again["nodes"][1]["color"], json!("#dc2626"));
+        assert_eq!(resolve_color("4"), Some(0x08b94e));
+        assert_eq!(resolve_color("#abc"), Some(0xaabbcc));
+        assert_eq!(resolve_color("빨강"), None);
+    }
+
+    #[test]
+    fn image_detection_and_rect_from_drag() {
+        let mut doc = CanvasDoc::default();
+        let id = doc.add_text(WorldRect::from_corners((303., 207.), (101., 98.)));
+        let node = &mut doc.nodes[0];
+        assert_eq!(node.id, id);
+        assert_eq!(node.rect, WorldRect { x: 100., y: 100., w: 200., h: 110. });
+        node.set_editable_text("이미지: chart.png");
+        assert!(node.is_image());
+        node.set_editable_text("이미지가 많다");
+        assert!(!node.is_image());
+    }
+}
