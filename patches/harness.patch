+fn activity_title(call: &ToolCall, cx: &App) -> String {
+    let from_input = call.raw_input.as_ref().and_then(|input| {
+        ["description", "command"]
+            .iter()
+            .find_map(|key| input.get(*key).and_then(|value| value.as_str()))
+            .filter(|text| !text.trim().is_empty())
+            .map(str::to_owned)
+    });
+    let source = from_input.unwrap_or_else(|| call.label.read(cx).source().to_string());
+    let line = source.lines().next().unwrap_or_default().replace('`', "");
+    let line = line.trim();
+    if line.chars().count() > 60 {
+        format!("{}…", line.chars().take(60).collect::<String>())
+    } else {
+        line.to_string()
+    }
+}
+
+fn is_background_activity(call: &ToolCall) -> bool {
+    call.id.0.starts_with("bgtask-") || call.id.0.starts_with("hook-")
+}
+
+fn activity_kind_label(kind: &acp_v2::ToolKind) -> &'static str {
+    match kind {
+        acp_v2::ToolKind::Read => "읽기",
+        acp_v2::ToolKind::Edit => "수정",
+        acp_v2::ToolKind::Delete => "삭제",
+        acp_v2::ToolKind::Move => "이동",
+        acp_v2::ToolKind::Search => "검색",
+        acp_v2::ToolKind::Execute => "실행",
+        acp_v2::ToolKind::Think => "생각",
+        acp_v2::ToolKind::Fetch => "웹",
+        _ => "기타",
+    }
+}
