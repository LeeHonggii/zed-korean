+fn run_docview(path: &Path) -> Option<Vec<Arc<Path>>> {
+    std::process::Command::new(DOCVIEW_PYTHON)
+        .arg(DOCVIEW_PY)
+        .arg(path)
+        .output()
+        .ok()?;
+    let home = std::env::var("HOME").ok()?;
+    let stem = path.file_stem()?.to_string_lossy().to_string();
+    let dir = PathBuf::from(home)
+        .join(".cache/docview")
+        .join(format!("{stem}_pages"));
+    let mut pages: Vec<PathBuf> = std::fs::read_dir(&dir)
+        .ok()?
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .filter(|p| p.extension().and_then(|x| x.to_str()) == Some("png"))
+        .collect();
+    pages.sort();
+    if pages.is_empty() {
+        return None;
+    }
+    Some(pages.into_iter().map(|p| Arc::from(p.as_path())).collect())
+}
