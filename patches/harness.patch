+
+    #[test]
+    fn jev_sums_today_tokens_only() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("jev.jsonl");
+        let today = Local::now();
+        let yesterday = today - chrono::Duration::days(1);
+        std::fs::write(
+            &path,
+            format!(
+                "{{\"ts\":\"{}\",\"input_tokens\":5400,\"output_tokens\":600}}\n{{\"ts\":\"{}\",\"input_tokens\":999999,\"output_tokens\":1}}\nnot json\n",
+                today.to_rfc3339(),
+                yesterday.to_rfc3339()
+            ),
+        )
+        .unwrap();
+        assert_eq!(jev_chip(&path, today.date_naive()).label(), "Jev 오늘 6.0k토큰");
