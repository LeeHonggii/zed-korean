+                running.push(format!("◐ {}", activity_title(call, cx)));
+            } else if matches!(status, ToolCallStatus::Completed) {
+                last_done_title = Some(activity_title(call, cx));
+                let kind = activity_kind_label(call.kind());
+                match done.iter_mut().find(|(label, _)| *label == kind) {
+                    Some((_, count)) => *count += 1,
+                    None => done.push((kind, 1)),
+                }
+            }
+        }
