+
+impl Render for CanvasView {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        if !self.fitted && !self.doc.nodes.is_empty() {
+            if self.bounds.get().is_some() {
+                self.fit();
+            } else {
+                cx.on_next_frame(window, |_, _, cx| cx.notify());
+            }
+        }
+        let colors = cx.theme().colors().clone();
+        let bounds_cell = self.bounds.clone();
+        let mut board = div()
+            .id("canvas-board")
+            .relative()
+            .flex_1()
+            .w_full()
+            .overflow_hidden()
+            .bg(colors.panel_background)
+            .track_focus(&self.focus_handle)
+            .on_key_down(cx.listener(Self::handle_key))
+            .on_mouse_down(MouseButton::Left, cx.listener(Self::handle_mouse_down))
+            .on_mouse_down(MouseButton::Middle, cx.listener(Self::handle_mouse_down))
+            .on_mouse_up(MouseButton::Left, cx.listener(Self::handle_mouse_up))
+            .on_mouse_up(MouseButton::Middle, cx.listener(Self::handle_mouse_up))
+            .on_mouse_move(cx.listener(Self::handle_mouse_move))
+            .on_scroll_wheel(cx.listener(Self::handle_scroll))
+            .on_pinch(cx.listener(Self::handle_pinch))
+            .child(
+                canvas(move |bounds, _, _| bounds_cell.set(Some(bounds)), |_, _, _, _| {})
+                    .absolute()
+                    .size_full(),
+            )
+            .children(self.render_nodes(cx));
+        if let Some(error) = &self.load_error {
+            board = board.child(
+                div()
+                    .absolute()
+                    .top_2()
+                    .left_2()
+                    .child(Label::new(error.clone()).color(Color::Error)),
+            );
+        } else if self.doc.nodes.is_empty() {
+            board = board.child(
+                div().absolute().top_4().left_4().child(
+                    Label::new("「＋ 슬라이드」로 틀을 만들고, 틀 안을 드래그해서 박스를 그리세요")
+                        .color(Color::Muted),
+                ),
+            );
+        }
+        let editor_label = match self
+            .selected
+            .as_ref()
+            .and_then(|id| self.doc.index_of(id))
+            .map(|index| self.doc.nodes[index].kind)
+        {
+            Some(NodeKind::Group) => "슬라이드 제목",
+            Some(NodeKind::File) => "파일 경로",
+            Some(NodeKind::Text) => "박스 글",
+            None => "선택 없음",
+        };
+        v_flex()
+            .size_full()
+            .bg(colors.editor_background)
+            .child(self.render_toolbar(cx))
+            .child(board)
+            .child(
+                v_flex()
+                    .w_full()
+                    .px_2()
+                    .py_1()
+                    .gap_1()
+                    .border_t_1()
+                    .border_color(colors.border)
+                    .child(
+                        Label::new(editor_label)
+                            .size(LabelSize::XSmall)
+                            .color(Color::Muted),
+                    )
+                    .child(self.editor.clone()),
+            )
+    }
+}
