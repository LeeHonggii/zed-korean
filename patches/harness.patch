+                "\n",
+                r#"{"type":"event_msg","payload":{"type":"token_count","rate_limits":{"primary":{"used_percent":40.0,"window_minutes":300,"resets_at":5600},"secondary":{"used_percent":6.0}}}}"#,
+                "\n",
+                r#"{"type":"response_item","payload":{}}"#,
+                "\n",
+            ),
+        )
+        .unwrap();
+        let chip = codex_chip(dir.path(), at(2000));
