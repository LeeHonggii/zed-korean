+
+    #[test]
+    fn duration_formats() {
+        assert_eq!(format_duration(Duration::from_secs(59 * 60)), "59분");
+        assert_eq!(format_duration(Duration::from_secs(26 * 3600)), "1일2시간");
+    }
+}
