@@ -0,0 +1,974 @@
+// 하네스 패치: .canvas(JSON Canvas) 박스 그리기 화면 — 드래그로 박스, 아래 칸에서 글, 덱 만들기 버튼.
+mod model;
+
+use std::{
+    cell::Cell,
+    path::{Path, PathBuf},
+    rc::Rc,
+    sync::Arc,
+    time::Duration,
+};
+
+use editor::{Editor, EditorEvent};
+use fs::Fs;
+use gpui::{
+    App, Bounds, Context, Entity, EventEmitter, FocusHandle, Focusable, Hsla, KeyDownEvent,
+    MouseButton, MouseDownEvent, MouseMoveEvent, MouseUpEvent, PinchEvent, Pixels, Point, Render,
+    ScrollDelta, ScrollWheelEvent, Subscription, Task, WeakEntity, Window, canvas, div, point, px,
+};
+use project::{Project, ProjectEntryId, ProjectPath};
+use ui::{Tooltip, prelude::*};
+use workspace::{
+    OpenOptions, Pane, Workspace,
+    item::{Item, ProjectItem},
+};
+
+use crate::model::{CanvasDoc, NodeKind, WorldRect};
+
+pub use crate::model::{SWATCHES, parse_hex};
+
+const DECK_PYTHON: &str = "/Users/lee-hong-gi/anaconda3/envs/harness-tools/bin/python";
+const DECK_SCRIPT: &str =
+    "/Users/lee-hong-gi/Desktop/codnut_main/00_System/scripts/deck/canvas_to_deck.py";
+const DECK_VAULT: &str = "/Users/lee-hong-gi/Desktop/codnut_main";
+const TEXT_WORLD_SIZE: f32 = 28.0;
+const HANDLE_PX: f32 = 12.0;
+const LABEL_BAR_PX: f32 = 26.0;
+const MIN_ZOOM: f32 = 0.05;
+const MAX_ZOOM: f32 = 4.0;
+const SCROLL_LINE: f32 = 20.0;
+const POLL: Duration = Duration::from_millis(1000);
+const STATE_FILE: &str = ".cache/harness/canvas_state.json";
+
+pub struct CanvasFile {
+    abs_path: PathBuf,
+    project_path: ProjectPath,
+    entry_id: Option<ProjectEntryId>,
+}
+
+impl project::ProjectItem for CanvasFile {
+    fn try_open(
+        project: &Entity<Project>,
+        path: &ProjectPath,
+        cx: &mut App,
+    ) -> Option<Task<anyhow::Result<Entity<Self>>>> {
+        let is_canvas = path
+            .path
+            .extension()
+            .is_some_and(|ext| ext.eq_ignore_ascii_case("canvas"));
+        if !is_canvas {
+            return None;
+        }
+        let abs_path = project.read(cx).absolute_path(path, cx)?;
+        let entry_id = project
+            .read(cx)
+            .entry_for_path(path, cx)
+            .map(|entry| entry.id);
+        let project_path = path.clone();
+        Some(Task::ready(Ok(cx.new(|_| CanvasFile {
+            abs_path,
+            project_path,
+            entry_id,
+        }))))
+    }
+
+    fn entry_id(&self, _: &App) -> Option<ProjectEntryId> {
+        self.entry_id
+    }
+
+    fn project_path(&self, _: &App) -> Option<ProjectPath> {
+        Some(self.project_path.clone())
+    }
+
+    fn is_dirty(&self) -> bool {
+        false
+    }
+}
+
+enum Drag {
+    Pan(Point<Pixels>),
+    Move {
+        targets: Vec<(usize, f64, f64)>,
+        start: (f64, f64),
+    },
+    Resize {
+        index: usize,
+        width: f64,
+        height: f64,
+        start: (f64, f64),
+    },
+    Create {
+        start: (f64, f64),
+        current: (f64, f64),
+    },
+}
+
+pub struct CanvasView {
+    file: Entity<CanvasFile>,
+    fs: Arc<dyn Fs>,
+    doc: CanvasDoc,
+    last_text: String,
+    load_error: Option<String>,
+    focus_handle: FocusHandle,
+    zoom: f32,
+    pan: Point<Pixels>,
+    fitted: bool,
+    bounds: Rc<Cell<Option<Bounds<Pixels>>>>,
+    selected: Option<String>,
+    drag: Option<Drag>,
+    editor: Entity<Editor>,
+    syncing_editor: bool,
+    status: SharedString,
+    workspace: Option<WeakEntity<Workspace>>,
+    _poll: Task<()>,
+    _subscriptions: Vec<Subscription>,
+}
+
+impl CanvasView {
+    fn new(
+        file: Entity<CanvasFile>,
+        project: Entity<Project>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let fs = project.read(cx).fs().clone();
+        let editor = cx.new(|cx| {
+            let mut editor = Editor::auto_height(2, 10, window, cx);
+            editor.set_placeholder_text(
+                "박스를 고르면 여기서 글을 고칩니다 · 이미지 / 이미지: 파일.png / 부제: … / ## 소제목 / - 글머리 / **굵게** / 색: 남색",
+                window,
+                cx,
+            );
+            editor
+        });
+        let subscription = cx.subscribe_in(&editor, window, Self::on_editor_event);
+        let abs_path = file.read(cx).abs_path.clone();
+        let poll = cx.spawn_in(window, {
+            let fs = fs.clone();
+            async move |this, cx| {
+                loop {
+                    let text = fs.load(&abs_path).await;
+                    let keep_going = this
+                        .update_in(cx, |this, window, cx| this.apply_disk_text(text, window, cx))
+                        .unwrap_or(false);
+                    if !keep_going {
+                        break;
+                    }
+                    cx.background_executor().timer(POLL).await;
+                }
+            }
+        });
+        Self {
+            file,
+            fs,
+            doc: CanvasDoc::default(),
+            last_text: String::new(),
+            load_error: None,
+            focus_handle: cx.focus_handle(),
+            zoom: 0.4,
+            pan: point(px(40.), px(40.)),
+            fitted: false,
+            bounds: Rc::new(Cell::new(None)),
+            selected: None,
+            drag: None,
+            editor,
+            syncing_editor: false,
+            status: "".into(),
+            workspace: Workspace::for_window(window, cx).map(|workspace| workspace.downgrade()),
+            _poll: poll,
+            _subscriptions: vec![subscription],
+        }
+    }
+
+    fn abs_path(&self, cx: &App) -> PathBuf {
+        self.file.read(cx).abs_path.clone()
+    }
+
+    fn publish_state(&self, cx: &App) {
+        let selected = self
+            .selected
+            .as_ref()
+            .and_then(|id| self.doc.index_of(id))
+            .map(|index| {
+                let node = &self.doc.nodes[index];
+                serde_json::json!({
+                    "id": node.id,
+                    "kind": match node.kind {
+                        NodeKind::Group => "slide",
+                        NodeKind::Text => "text",
+                        NodeKind::File => "file",
+                    },
+                    "text": node.text,
+                })
+            });
+        let state = serde_json::json!({
+            "canvas": self.abs_path(cx),
+            "selected": selected,
+        });
+        let Some(home) = std::env::var_os("HOME") else {
+            return;
+        };
+        let path = PathBuf::from(home).join(STATE_FILE);
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent).ok();
+        }
+        if let Err(error) = std::fs::write(&path, state.to_string()) {
+            log::warn!("그림판 상태 기록 실패: {error:#}");
+        }
+    }
+
+    fn apply_disk_text(
+        &mut self,
+        text: anyhow::Result<String>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        let text = match text {
+            Ok(text) => text,
+            Err(error) => {
+                if self.last_text.is_empty() {
+                    self.load_error = Some(format!("{error:#}"));
+                    cx.notify();
+                }
+                return true;
+            }
+        };
+        if text == self.last_text || self.drag.is_some() {
+            return true;
+        }
+        let first_load = self.last_text.is_empty();
+        match CanvasDoc::parse(&text) {
+            Ok(doc) => {
+                self.doc = doc;
+                self.last_text = text;
+                self.load_error = None;
+                if self
+                    .selected
+                    .as_ref()
+                    .is_some_and(|id| self.doc.index_of(id).is_none())
+                {
+                    self.selected = None;
+                }
+                self.sync_editor(window, cx);
+                if first_load {
+                    self.publish_state(cx);
+                }
+                cx.notify();
+            }
+            Err(error) => {
+                self.load_error = Some(format!("캔버스 형식을 못 읽음: {error:#}"));
+                cx.notify();
+            }
+        }
+        true
+    }
+
+    fn save(&mut self, cx: &mut Context<Self>) {
+        let text = self.doc.to_text();
+        if text == self.last_text {
+            return;
+        }
+        self.last_text = text.clone();
+        let fs = self.fs.clone();
+        let path = self.abs_path(cx);
+        cx.background_spawn(async move {
+            if let Err(error) = fs.atomic_write(path, text).await {
+                log::error!("캔버스 저장 실패: {error:#}");
+            }
+        })
+        .detach();
+    }
+
+    fn sync_editor(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        let text = self
+            .selected
+            .as_ref()
+            .and_then(|id| self.doc.index_of(id))
+            .map(|index| self.doc.nodes[index].editable_text())
+            .unwrap_or_default();
+        if self.editor.read(cx).text(cx) == text {
+            return;
+        }
+        if self.editor.focus_handle(cx).is_focused(window) && self.selected.is_some() {
+            return;
+        }
+        self.syncing_editor = true;
+        self.editor
+            .update(cx, |editor, cx| editor.set_text(text, window, cx));
+        self.syncing_editor = false;
+    }
+
+    fn on_editor_event(
+        &mut self,
+        editor: &Entity<Editor>,
+        event: &EditorEvent,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if self.syncing_editor || !matches!(event, EditorEvent::BufferEdited) {
+            return;
+        }
+        let Some(index) = self.selected.as_ref().and_then(|id| self.doc.index_of(id)) else {
+            return;
+        };
+        let text = editor.read(cx).text(cx);
+        self.doc.nodes[index].set_editable_text(&text);
+        self.save(cx);
+        cx.notify();
+    }
+
+    fn select(&mut self, id: Option<String>, window: &mut Window, cx: &mut Context<Self>) {
+        self.selected = id;
+        self.syncing_editor = true;
+        let text = self
+            .selected
+            .as_ref()
+            .and_then(|id| self.doc.index_of(id))
+            .map(|index| self.doc.nodes[index].editable_text())
+            .unwrap_or_default();
+        self.editor
+            .update(cx, |editor, cx| editor.set_text(text, window, cx));
+        self.syncing_editor = false;
+        self.publish_state(cx);
+        cx.notify();
+    }
+
+    fn origin(&self) -> Point<Pixels> {
+        self.bounds
+            .get()
+            .map(|bounds| bounds.origin)
+            .unwrap_or_default()
+    }
+
+    fn to_world(&self, position: Point<Pixels>) -> (f64, f64) {
+        let local = position - self.origin() - self.pan;
+        (
+            (f32::from(local.x) / self.zoom) as f64,
+            (f32::from(local.y) / self.zoom) as f64,
+        )
+    }
+
+    fn to_screen(&self, x: f64, y: f64) -> Point<Pixels> {
+        point(
+            self.pan.x + px(x as f32 * self.zoom),
+            self.pan.y + px(y as f32 * self.zoom),
+        )
+    }
+
+    fn fit(&mut self) {
+        let Some(bounds) = self.bounds.get() else {
+            return;
+        };
+        let Some(extent) = self.doc.extent() else {
+            self.zoom = 0.4;
+            self.pan = point(px(40.), px(40.));
+            self.fitted = true;
+            return;
+        };
+        let width = f32::from(bounds.size.width).max(100.);
+        let height = f32::from(bounds.size.height).max(100.);
+        let margin = 40.0;
+        let zoom = ((width - margin * 2.) / extent.w as f32)
+            .min((height - margin * 2.) / (extent.h as f32 + 60.))
+            .clamp(MIN_ZOOM, 1.0);
+        self.zoom = zoom;
+        self.pan = point(
+            px(margin - extent.x as f32 * zoom),
+            px(margin + LABEL_BAR_PX - extent.y as f32 * zoom),
+        );
+        self.fitted = true;
+    }
+
+    fn set_zoom(&mut self, zoom: f32, anchor: Point<Pixels>) {
+        let zoom = zoom.clamp(MIN_ZOOM, MAX_ZOOM);
+        let (wx, wy) = self.to_world(anchor);
+        self.zoom = zoom;
+        let local = anchor - self.origin();
+        self.pan = point(
+            local.x - px(wx as f32 * zoom),
+            local.y - px(wy as f32 * zoom),
+        );
+    }
+
+    fn hit_handle(&self, position: Point<Pixels>) -> Option<usize> {
+        let index = self.selected.as_ref().and_then(|id| self.doc.index_of(id))?;
+        let rect = self.doc.nodes[index].rect;
+        let corner = self.to_screen(rect.x + rect.w, rect.y + rect.h) + self.origin();
+        let delta = position - corner;
+        (f32::from(delta.x).abs() <= HANDLE_PX && f32::from(delta.y).abs() <= HANDLE_PX)
+            .then_some(index)
+    }
+
+    fn hit_label(&self, position: Point<Pixels>) -> Option<usize> {
+        self.doc.nodes.iter().enumerate().rev().find_map(|(index, node)| {
+            if node.kind != NodeKind::Group {
+                return None;
+            }
+            let top_left = self.to_screen(node.rect.x, node.rect.y) + self.origin();
+            let local = position - top_left;
+            let x = f32::from(local.x);
+            let y = f32::from(local.y);
+            let width = (node.rect.w as f32 * self.zoom).max(120.);
+            (x >= 0. && x <= width && y >= -LABEL_BAR_PX && y <= 0.).then_some(index)
+        })
+    }
+
+    fn handle_mouse_down(
+        &mut self,
+        event: &MouseDownEvent,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        window.focus(&self.focus_handle, cx);
+        if event.button == MouseButton::Middle || event.modifiers.alt {
+            self.drag = Some(Drag::Pan(event.position));
+            return;
+        }
+        if event.button != MouseButton::Left {
+            return;
+        }
+        let world = self.to_world(event.position);
+        if let Some(index) = self.hit_handle(event.position) {
+            let rect = self.doc.nodes[index].rect;
+            self.drag = Some(Drag::Resize {
+                index,
+                width: rect.w,
+                height: rect.h,
+                start: world,
+            });
+            return;
+        }
+        let hit = self
+            .doc
+            .hit_content(world.0, world.1)
+            .or_else(|| self.hit_label(event.position));
+        if let Some(index) = hit {
+            let id = self.doc.nodes[index].id.clone();
+            if self.selected.as_deref() != Some(id.as_str()) {
+                self.select(Some(id), window, cx);
+            }
+            let mut targets = vec![index];
+            if self.doc.nodes[index].kind == NodeKind::Group {
+                targets.extend(self.doc.children_of(index));
+            }
+            let targets = targets
+                .into_iter()
+                .map(|i| (i, self.doc.nodes[i].rect.x, self.doc.nodes[i].rect.y))
+                .collect();
+            self.drag = Some(Drag::Move {
+                targets,
+                start: world,
+            });
+        } else {
+            self.drag = Some(Drag::Create {
+                start: world,
+                current: world,
+            });
+        }
+        cx.notify();
+    }
+
+    fn handle_mouse_move(
+        &mut self,
+        event: &MouseMoveEvent,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let world = self.to_world(event.position);
+        match &mut self.drag {
+            Some(Drag::Pan(last)) => {
+                let delta = event.position - *last;
+                *last = event.position;
+                self.pan += delta;
+            }
+            Some(Drag::Move { targets, start }) => {
+                let dx = model::snap(world.0 - start.0);
+                let dy = model::snap(world.1 - start.1);
+                for (index, x, y) in targets.iter() {
+                    self.doc.nodes[*index].rect.x = x + dx;
+                    self.doc.nodes[*index].rect.y = y + dy;
+                }
+            }
+            Some(Drag::Resize {
+                index,
+                width,
+                height,
+                start,
+            }) => {
+                let rect = &mut self.doc.nodes[*index].rect;
+                rect.w = model::snap(*width + world.0 - start.0).max(60.);
+                rect.h = model::snap(*height + world.1 - start.1).max(40.);
+            }
+            Some(Drag::Create { current, .. }) => *current = world,
+            None => return,
+        }
+        cx.notify();
+    }
+
+    fn handle_mouse_up(&mut self, _event: &MouseUpEvent, window: &mut Window, cx: &mut Context<Self>) {
+        match self.drag.take() {
+            Some(Drag::Create { start, current }) => {
+                let rect = WorldRect::from_corners(start, current);
+                if rect.w as f32 * self.zoom >= 16. && rect.h as f32 * self.zoom >= 12. {
+                    let id = self.doc.add_text(rect);
+                    self.save(cx);
+                    self.select(Some(id), window, cx);
+                    window.focus(&self.editor.focus_handle(cx), cx);
+                } else {
+                    self.select(None, window, cx);
+                }
+            }
+            Some(Drag::Move { .. }) | Some(Drag::Resize { .. }) => self.save(cx),
+            Some(Drag::Pan(_)) | None => {}
+        }
+        cx.notify();
+    }
+
+    fn handle_scroll(&mut self, event: &ScrollWheelEvent, _: &mut Window, cx: &mut Context<Self>) {
+        if event.modifiers.platform || event.modifiers.control {
+            let delta: f32 = match event.delta {
+                ScrollDelta::Pixels(pixels) => pixels.y.into(),
+                ScrollDelta::Lines(lines) => lines.y * SCROLL_LINE,
+            };
+            let factor = if delta > 0. {
+                1. + delta.abs() * 0.01
+            } else {
+                1. / (1. + delta.abs() * 0.01)
+            };
+            self.set_zoom(self.zoom * factor, event.position);
+        } else {
+            let delta = match event.delta {
+                ScrollDelta::Pixels(pixels) => pixels,
+                ScrollDelta::Lines(lines) => lines.map(|d| px(d * SCROLL_LINE)),
+            };
+            self.pan += delta;
+        }
+        cx.notify();
+    }
+
+    fn handle_pinch(&mut self, event: &PinchEvent, _: &mut Window, cx: &mut Context<Self>) {
+        self.set_zoom(self.zoom * (1. + event.delta), event.position);
+        cx.notify();
+    }
+
+    fn handle_key(&mut self, event: &KeyDownEvent, window: &mut Window, cx: &mut Context<Self>) {
+        if !self.focus_handle.is_focused(window) {
+            return;
+        }
+        let key = event.keystroke.key.as_str();
+        if key == "backspace" || key == "delete" {
+            if let Some(id) = self.selected.clone() {
+                self.doc.remove(&id);
+                self.save(cx);
+                self.select(None, window, cx);
+                cx.stop_propagation();
+            }
+        } else if key == "escape" {
+            self.select(None, window, cx);
+        }
+    }
+
+    fn add_slide(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        let id = self.doc.add_slide();
+        self.save(cx);
+        self.select(Some(id.clone()), window, cx);
+        if let Some(index) = self.doc.index_of(&id) {
+            let rect = self.doc.nodes[index].rect;
+            if let Some(bounds) = self.bounds.get() {
+                let width = f32::from(bounds.size.width);
+                self.zoom = ((width - 80.) / rect.w as f32).clamp(MIN_ZOOM, 1.0);
+                self.pan = point(
+                    px(40. - rect.x as f32 * self.zoom),
+                    px(40. + LABEL_BAR_PX - rect.y as f32 * self.zoom),
+                );
+            }
+        }
+        window.focus(&self.editor.focus_handle(cx), cx);
+    }
+
+    fn set_color(&mut self, color: Option<&'static str>, cx: &mut Context<Self>) {
+        let Some(index) = self.selected.as_ref().and_then(|id| self.doc.index_of(id)) else {
+            self.status = "색을 바꿀 박스나 슬라이드를 먼저 고르세요".into();
+            cx.notify();
+            return;
+        };
+        self.doc.nodes[index].set_color(color);
+        self.save(cx);
+        cx.notify();
+    }
+
+    fn build_deck(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        self.save(cx);
+        let canvas_path = self.abs_path(cx);
+        self.status = "덱 만드는 중…".into();
+        cx.notify();
+        let run = cx.background_spawn(async move { run_deck_script(&canvas_path) });
+        cx.spawn_in(window, async move |this, cx| {
+            let result = run.await;
+            this.update_in(cx, |this, window, cx| {
+                match result {
+                    Ok((message, pptx)) => {
+                        this.status = message.into();
+                        if let Some(workspace) = this.workspace.as_ref().and_then(|w| w.upgrade()) {
+                            workspace.update(cx, |workspace, cx| {
+                                workspace
+                                    .open_abs_path(pptx, OpenOptions::default(), window, cx)
+                                    .detach_and_log_err(cx);
+                            });
+                        }
+                    }
+                    Err(error) => this.status = format!("덱 만들기 실패: {error}").into(),
+                }
+                cx.notify();
+            })
+            .ok();
+        })
+        .detach();
+    }
+
+    fn render_toolbar(&self, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = cx.theme().colors().clone();
+        let mut swatches = h_flex().gap_1();
+        for (index, (name, hex)) in SWATCHES.iter().enumerate() {
+            let fill: Hsla = hex
+                .and_then(parse_hex)
+                .map(|value| gpui::rgb(value).into())
+                .unwrap_or(colors.text_muted);
+            swatches = swatches.child(
+                div()
+                    .id(("canvas-swatch", index))
+                    .size(px(16.))
+                    .rounded_full()
+                    .bg(fill)
+                    .border_1()
+                    .border_color(colors.border)
+                    .cursor_pointer()
+                    .tooltip(Tooltip::text(*name))
+                    .on_click(cx.listener(move |this, _, _, cx| this.set_color(*hex, cx))),
+            );
+        }
+        h_flex()
+            .w_full()
+            .px_2()
+            .py_1()
+            .gap_2()
+            .border_b_1()
+            .border_color(colors.border)
+            .bg(colors.toolbar_background)
+            .child(
+                Button::new("canvas-add-slide", "＋ 슬라이드")
+                    .label_size(LabelSize::Small)
+                    .on_click(cx.listener(|this, _, window, cx| this.add_slide(window, cx))),
+            )
+            .child(
+                Button::new("canvas-fit", "전체 보기")
+                    .label_size(LabelSize::Small)
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        this.fit();
+                        cx.notify();
+                    })),
+            )
+            .child(Label::new("색").size(LabelSize::Small).color(Color::Muted))
+            .child(swatches)
+            .child(div().flex_1())
+            .child(
+                Label::new(self.status.clone())
+                    .size(LabelSize::Small)
+                    .color(Color::Muted)
+                    .truncate(),
+            )
+            .child(
+                Button::new("canvas-build-deck", "덱 만들기")
+                    .style(ButtonStyle::Filled)
+                    .label_size(LabelSize::Small)
+                    .on_click(cx.listener(|this, _, window, cx| this.build_deck(window, cx))),
+            )
+    }
+
+    fn render_nodes(&self, cx: &mut Context<Self>) -> Vec<AnyElement> {
+        let colors = cx.theme().colors().clone();
+        let accent = colors.text_accent;
+        let mut elements = Vec::new();
+        let mut order: Vec<usize> = (0..self.doc.nodes.len()).collect();
+        order.sort_by_key(|&index| self.doc.nodes[index].kind != NodeKind::Group);
+        for index in order {
+            let node = &self.doc.nodes[index];
+            let selected = self.selected.as_deref() == Some(node.id.as_str());
+            let origin = self.to_screen(node.rect.x, node.rect.y);
+            let width = px(node.rect.w as f32 * self.zoom);
+            let height = px(node.rect.h as f32 * self.zoom);
+            let tint: Option<Hsla> = node
+                .color
+                .as_deref()
+                .and_then(model::resolve_color)
+                .map(|value| gpui::rgb(value).into());
+            let line = tint.unwrap_or(colors.border);
+            let base = div()
+                .absolute()
+                .left(origin.x)
+                .top(origin.y)
+                .w(width)
+                .h(height);
+            match node.kind {
+                NodeKind::Group => {
+                    elements.push(
+                        base.border_2()
+                            .border_color(if selected { accent } else { line })
+                            .rounded_sm()
+                            .bg(colors.editor_background)
+                            .into_any_element(),
+                    );
+                    elements.push(
+                        div()
+                            .absolute()
+                            .left(origin.x)
+                            .top(origin.y - px(LABEL_BAR_PX))
+                            .h(px(LABEL_BAR_PX))
+                            .px_1()
+                            .flex()
+                            .items_center()
+                            .child(
+                                Label::new(if node.text.trim().is_empty() {
+                                    "(슬라이드 제목 없음)".to_string()
+                                } else {
+                                    node.text.clone()
+                                })
+                                .size(LabelSize::Small)
+                                .color(if selected { Color::Accent } else { Color::Default }),
+                            )
+                            .into_any_element(),
+                    );
+                }
+                NodeKind::Text | NodeKind::File => {
+                    let is_image = node.is_image();
+                    let font = px((TEXT_WORLD_SIZE * self.zoom).max(6.));
+                    let body = if node.kind == NodeKind::File {
+                        format!("🖼 {}", node.text)
+                    } else if is_image {
+                        format!("🖼 {}", node.text)
+                    } else {
+                        node.text.clone()
+                    };
+                    let mut element = base
+                        .overflow_hidden()
+                        .p(px(6. * self.zoom.max(0.3)))
+                        .text_size(font)
+                        .line_height(font * 1.45)
+                        .text_color(colors.text)
+                        .bg(colors.surface_background.opacity(0.6))
+                        .rounded_sm()
+                        .child(body);
+                    element = if is_image || node.kind == NodeKind::File {
+                        element.border_1().border_dashed().border_color(line)
+                    } else {
+                        element.border_1().border_color(line.opacity(0.7))
+                    };
+                    if let Some(tint) = tint {
+                        element = element.border_l_4().border_color(tint);
+                    }
+                    if selected {
+                        element = element.border_2().border_color(accent);
+                    }
+                    elements.push(element.into_any_element());
+                }
+            }
+            if selected {
+                let corner = self.to_screen(node.rect.x + node.rect.w, node.rect.y + node.rect.h);
+                elements.push(
+                    div()
+                        .absolute()
+                        .left(corner.x - px(HANDLE_PX / 2.))
+                        .top(corner.y - px(HANDLE_PX / 2.))
+                        .size(px(HANDLE_PX))
+                        .rounded_sm()
+                        .bg(accent)
+                        .cursor_nwse_resize()
+                        .into_any_element(),
+                );
+            }
+        }
+        if let Some(Drag::Create { start, current }) = &self.drag {
+            let rect = WorldRect::from_corners(*start, *current);
+            let origin = self.to_screen(rect.x, rect.y);
+            elements.push(
+                div()
+                    .absolute()
+                    .left(origin.x)
+                    .top(origin.y)
+                    .w(px(rect.w as f32 * self.zoom))
+                    .h(px(rect.h as f32 * self.zoom))
+                    .border_1()
+                    .border_dashed()
+                    .border_color(accent)
+                    .bg(accent.opacity(0.08))
+                    .into_any_element(),
+            );
+        }
+        elements
+    }
+}
+
+fn run_deck_script(canvas_path: &Path) -> Result<(String, PathBuf), String> {
+    let output = std::process::Command::new(DECK_PYTHON)
+        .arg(DECK_SCRIPT)
+        .arg("--canvas")
+        .arg(canvas_path)
+        .arg("--mode")
+        .arg("both")
+        .arg("--vault")
+        .arg(DECK_VAULT)
+        .output()
+        .map_err(|error| error.to_string())?;
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        let last = stderr.lines().last().unwrap_or("알 수 없는 오류").to_string();
+        return Err(last);
+    }
+    let stdout = String::from_utf8_lossy(&output.stdout).trim().to_string();
+    let pptx = canvas_path.with_extension("pptx");
+    let summary = stdout.split(" · /").next().unwrap_or(&stdout).to_string();
+    Ok((format!("완료 · {summary}"), pptx))
+}
