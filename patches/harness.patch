@@ -0,0 +1,276 @@
+// 하네스 패치: 에이전트 보드 — 살아 있는 대화(Claude·Codex·Zed Agent+Ollama)를 가운데에 칸으로 나란히 띄운다.
+use std::collections::{HashMap, HashSet};
+use std::time::{Duration, Instant};
+
+use acp_thread::ThreadStatus;
+use gpui::{
+    App, Context, Entity, EventEmitter, FocusHandle, Focusable, Hsla, Render, Task, WeakEntity,
+    Window, actions, px,
+};
+use ui::prelude::*;
+use workspace::{Workspace, item::Item};
+
+use crate::{AgentPanel, ConversationView, ThreadId};
+
+actions!(
+    agent_board,
+    [
+        /// 살아 있는 에이전트 대화들을 가운데에 나란히 띄운다.
+        OpenAgentBoard
+    ]
+);
+
+const POLL: Duration = Duration::from_millis(1000);
+const MAX_COLUMNS: usize = 4;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BoardState {
+    Idle,
+    Running,
+    Waiting,
+    Unseen,
+    Error,
+}
+
+impl BoardState {
+    pub fn dot(self, cx: &App) -> (Hsla, &'static str) {
+        let status = cx.theme().status();
+        match self {
+            BoardState::Idle => (cx.theme().colors().text_muted, "○"),
+            BoardState::Running => (status.warning, "●"),
+            BoardState::Waiting | BoardState::Error => (status.error, "●"),
+            BoardState::Unseen => (status.info, "●"),
+        }
+    }
+
+    fn label(self) -> &'static str {
+        match self {
+            BoardState::Idle => "쉬는 중",
+            BoardState::Running => "작업 중",
+            BoardState::Waiting => "허락 대기",
+            BoardState::Unseen => "끝남 · 안 봄",
+            BoardState::Error => "오류",
+        }
+    }
+
+    fn order(self) -> u8 {
+        match self {
+            BoardState::Waiting => 0,
+            BoardState::Running => 1,
+            BoardState::Unseen => 2,
+            BoardState::Error => 3,
+            BoardState::Idle => 4,
+        }
+    }
+}
+
+struct Column {
+    id: ThreadId,
+    view: Entity<ConversationView>,
+    agent: SharedString,
+    title: SharedString,
+    state: BoardState,
+    running_since: Option<Instant>,
+}
+
+pub struct AgentBoard {
+    workspace: WeakEntity<Workspace>,
+    focus_handle: FocusHandle,
+    columns: Vec<Column>,
+    last_running: HashMap<ThreadId, Instant>,
+    unseen: HashSet<ThreadId>,
+    _poll: Task<()>,
+}
+
+fn agent_label(view: &Entity<ConversationView>, cx: &App) -> Option<(SharedString, SharedString, bool, ThreadStatus, bool)> {
+    let conversation = view.read(cx);
+    let pending = conversation.root_thread_has_pending_tool_call(cx);
+    let thread_view = conversation.root_thread_view()?;
+    let thread_view = thread_view.read(cx);
+    let thread = thread_view.thread.read(cx);
+    if thread.entries().is_empty() {
+        return None;
+    }
+    let model = thread_view
+        .as_native_thread(cx)
+        .and_then(|native| native.read(cx).model().map(|model| model.name.0.clone()));
+    let agent: SharedString = match model {
+        Some(model) => format!("{} · {}", thread_view.agent_display_name, model).into(),
+        None => thread_view.agent_display_name.clone(),
+    };
+    let title = thread.title().unwrap_or_else(|| "새 대화".into());
+    Some((agent, title, pending, thread.status(), thread.had_error()))
+}
+
+impl AgentBoard {
+    fn new(workspace: WeakEntity<Workspace>, cx: &mut Context<Self>) -> Self {
+        let poll = cx.spawn(async move |this, cx| {
+            loop {
+                if this.update(cx, |this, cx| this.refresh(cx)).is_err() {
+                    break;
+                }
+                cx.background_executor().timer(POLL).await;
+            }
+        });
+        Self {
+            workspace,
+            focus_handle: cx.focus_handle(),
+            columns: Vec::new(),
+            last_running: HashMap::new(),
+            unseen: HashSet::new(),
+            _poll: poll,
+        }
+    }
+
+    fn refresh(&mut self, cx: &mut Context<Self>) {
+        let Some(workspace) = self.workspace.upgrade() else {
+            return;
+        };
+        let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx) else {
+            return;
+        };
+        let views = panel.read(cx).conversation_views();
+        let mut columns = Vec::new();
+        for view in views {
+            let id = view.read(cx).parent_id();
+            let Some((agent, title, pending, status, error)) = agent_label(&view, cx) else {
+                continue;
+            };
+            let running = status == ThreadStatus::Generating;
+            if running {
+                self.last_running.entry(id).or_insert_with(Instant::now);
+            } else if self.last_running.remove(&id).is_some() {
+                self.unseen.insert(id);
+            }
+            let state = if pending {
+                BoardState::Waiting
+            } else if error {
+                BoardState::Error
+            } else if running {
+                BoardState::Running
+            } else if self.unseen.contains(&id) {
+                BoardState::Unseen
+            } else {
+                BoardState::Idle
+            };
+            columns.push(Column {
+                id,
+                view,
+                agent,
+                title,
+                state,
+                running_since: self.last_running.get(&id).copied(),
+            });
+        }
+        columns.sort_by_key(|column| column.state.order());
+        columns.truncate(MAX_COLUMNS);
+        self.columns = columns;
+        cx.notify();
+    }
+
+    fn render_column(&self, column: &Column, cx: &mut Context<Self>) -> AnyElement {
+        let colors = cx.theme().colors().clone();
+        let (color, glyph) = column.state.dot(cx);
+        let mut status = column.state.label().to_string();
+        if let Some(since) = column.running_since {
+            status.push_str(&format!(" · {}s", since.elapsed().as_secs()));
+        }
+        let id = column.id;
+        v_flex()
+            .flex_1()
+            .min_w(px(320.))
+            .h_full()
+            .border_r_1()
+            .border_color(colors.border)
+            .child(
+                h_flex()
+                    .id(SharedString::from(format!("board-head-{id:?}")))
+                    .gap_1p5()
+                    .px_2()
+                    .py_1()
+                    .border_b_1()
+                    .border_color(colors.border)
+                    .bg(colors.toolbar_background)
+                    .cursor_pointer()
+                    .child(div().text_color(color).child(glyph))
+                    .child(Label::new(column.agent.clone()).size(LabelSize::Small))
+                    .child(
+                        Label::new(column.title.clone())
+                            .size(LabelSize::Small)
+                            .color(Color::Muted)
+                            .truncate(),
+                    )
+                    .child(div().flex_1())
+                    .child(Label::new(status).size(LabelSize::XSmall).color(Color::Muted))
+                    .on_click(cx.listener(move |this, _, _, cx| {
+                        this.unseen.remove(&id);
+                        this.refresh(cx);
+                    })),
+            )
+            .child(div().flex_1().min_h_0().child(column.view.clone()))
+            .into_any_element()
+    }
+}
+
+impl EventEmitter<()> for AgentBoard {}
+
+impl Focusable for AgentBoard {
+    fn focus_handle(&self, _: &App) -> FocusHandle {
+        self.focus_handle.clone()
+    }
+}
+
+impl Item for AgentBoard {
+    type Event = ();
+
+    fn tab_content_text(&self, _detail: usize, _cx: &App) -> SharedString {
+        "에이전트 보드".into()
+    }
+
+    fn tab_icon(&self, _: &Window, _: &App) -> Option<Icon> {
+        Some(Icon::new(IconName::ZedAgent))
+    }
+}
+
+impl Render for AgentBoard {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = cx.theme().colors().clone();
+        let mut columns = Vec::new();
+        for column in &self.columns {
+            columns.push(self.render_column(column, cx));
+        }
+        v_flex()
+            .size_full()
+            .track_focus(&self.focus_handle)
+            .bg(colors.editor_background)
+            .when(columns.is_empty(), |el| {
+                el.child(
+                    div().p_4().child(
+                        Label::new("열려 있는 대화가 없습니다 — 에이전트 패널에서 대화를 시작하면 여기에 칸이 생깁니다")
+                            .color(Color::Muted),
+                    ),
+                )
+            })
+            .child(h_flex().size_full().items_start().children(columns))
+    }
+}
+
+pub fn open_agent_board(workspace: &mut Workspace, window: &mut Window, cx: &mut Context<Workspace>) {
+    let existing = workspace.items_of_type::<AgentBoard>(cx).next();
+    if let Some(existing) = existing {
+        workspace.activate_item(&existing, true, true, window, cx);
+        return;
+    }
+    let handle = cx.entity().downgrade();
+    let board = cx.new(|cx| AgentBoard::new(handle, cx));
+    workspace.add_item_to_active_pane(Box::new(board), None, true, window, cx);
+}
+
+pub fn init(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _, _| {
+        workspace.register_action(|workspace, _: &OpenAgentBoard, window, cx| {
+            open_agent_board(workspace, window, cx);
+        });
+    })
+    .detach();
+}
