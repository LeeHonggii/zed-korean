+// 하네스 패치: 명령 안에 ``` 줄이 있어도 코드 블록이 중간에 닫히지 않게, 명령 속 가장 긴 백틱 묶음보다 긴 울타리로 감싼다.
+pub fn fence_shell_command(command: &str) -> String {
+    let longest_run = command
+        .split(|c| c != '`')
+        .map(str::len)
+        .max()
+        .unwrap_or(0);
+    let fence = "`".repeat(longest_run.max(2) + 1);
+    format!("{fence}sh\n{command}\n{fence}")
+}
+
+pub fn unfence_shell_command(source: &str) -> Option<&str> {
+    let fence_len = source.chars().take_while(|c| *c == '`').count();
+    if fence_len < 3 {
+        return None;
+    }
+    let fence = &source[..fence_len];
+    let body = source[fence_len..]
+        .strip_prefix("sh\n")
+        .or_else(|| source[fence_len..].strip_prefix('\n'))?;
+    body.strip_suffix(fence)?.strip_suffix('\n')
+}
+
+#[cfg(test)]
+mod fence_tests {
+    use super::*;
+
+    #[test]
+    fn plain_command_uses_three_backticks() {
+        assert_eq!(fence_shell_command("ls -la"), "```sh\nls -la\n```");
+        assert_eq!(unfence_shell_command("```sh\nls -la\n```"), Some("ls -la"));
+    }
+
+    #[test]
+    fn command_with_fence_line_gets_longer_fence() {
+        let command = "cat > a.md <<'EOF'\n```bash\necho hi\n```\nEOF";
+        let fenced = fence_shell_command(command);
+        assert!(fenced.starts_with("````sh\n"));
+        assert!(fenced.ends_with("\n````"));
+        assert_eq!(unfence_shell_command(&fenced), Some(command));
+    }
+
+    #[test]
+    fn unfenced_source_is_rejected() {
+        assert_eq!(unfence_shell_command("ls -la"), None);
+        assert_eq!(unfence_shell_command("```\nls\n```"), Some("ls"));
+    }
+}
