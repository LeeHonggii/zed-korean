diff --git a/crates/arena_view/src/arena_view.rs b/crates/arena_view/src/arena_view.rs
new file mode 100644
index 0000000..c49a693
--- /dev/null
+++ b/crates/arena_view/src/arena_view.rs
@@ -0,0 +1,397 @@
+// 하네스 패치: 코드 아레나 실시간 화면 — ~/.harness/arena/<run>/<label>.json·.live.txt 를 읽어 모델 칸을 나란히 보여 준다.
+mod model;
+
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use gpui::{
+    App, AppContext as _, Context, Entity, EventEmitter, FocusHandle, Focusable, Global, Hsla,
+    Render, ScrollHandle, Task, Window, actions, div, px,
+};
+use settings::Settings as _;
+use theme_settings::ThemeSettings;
+use ui::prelude::*;
+use workspace::{Workspace, item::Item};
+
+pub use crate::model::{ArenaEntry, ArenaRun, ArenaState, format_elapsed};
+
+actions!(
+    arena_view,
+    [
+        /// 코드 아레나 화면을 연다.
+        OpenArena
+    ]
+);
+
+const POLL: Duration = Duration::from_millis(1000);
+const MAX_AGE_SECS: f64 = 24. * 3600.;
+const LIVE_TAIL_BYTES: u64 = 24_000;
+const RUN_TABS: usize = 8;
+
+fn now_secs() -> f64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs_f64())
+        .unwrap_or_default()
+}
+
+fn arena_root() -> Option<PathBuf> {
+    std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".harness/arena"))
+}
+
+fn pid_alive(pid: u32) -> bool {
+    unsafe { libc::kill(pid as i32, 0) == 0 }
+}
+
+pub struct ArenaStore {
+    pub runs: Vec<ArenaRun>,
+    seen: HashSet<(String, String)>,
+    _poll: Task<()>,
+}
+
+struct GlobalArenaStore(Entity<ArenaStore>);
+
+impl Global for GlobalArenaStore {}
+
+impl ArenaStore {
+    pub fn global(cx: &App) -> Option<Entity<ArenaStore>> {
+        cx.try_global::<GlobalArenaStore>().map(|g| g.0.clone())
+    }
+
+    pub fn runs_for_session<'a>(&'a self, session: &'a str) -> impl Iterator<Item = &'a ArenaRun> {
+        self.runs.iter().filter(move |run| run.session() == Some(session))
+    }
+
+    pub fn state_of(&self, entry: &ArenaEntry) -> ArenaState {
+        entry.effective_state(now_secs(), pid_alive)
+    }
+
+    pub fn is_seen(&self, entry: &ArenaEntry) -> bool {
+        self.seen
+            .contains(&(entry.run.clone(), entry.label.clone()))
+    }
+
+    fn mark_run_seen(&mut self, run: &ArenaRun) -> bool {
+        let mut changed = false;
+        for entry in &run.entries {
+            if entry.state == "done" {
+                changed |= self.seen.insert((entry.run.clone(), entry.label.clone()));
+            }
+        }
+        changed
+    }
+}
+
+pub fn dot(state: ArenaState, seen: bool, cx: &App) -> (Hsla, &'static str) {
+    let status = cx.theme().status();
+    match state {
+        ArenaState::Waiting => (cx.theme().colors().text_muted, "○"),
+        ArenaState::Running => (status.warning, "●"),
+        ArenaState::Done if seen => (cx.theme().colors().text_muted, "✓"),
+        ArenaState::Done => (status.info, "●"),
+        ArenaState::Failed | ArenaState::Stalled => (status.error, "●"),
+    }
+}
+
+pub fn entry_summary(entry: &ArenaEntry, state: ArenaState) -> String {
+    let mut parts = vec![entry.role_label().to_string()];
+    if state == ArenaState::Stalled {
+        parts.push("멈춤".into());
+    }
+    if entry.tokens > 0 {
+        parts.push(format!("{}tok", entry.tokens));
+    }
+    if let Some(elapsed) = entry.elapsed(now_secs()) {
+        parts.push(format_elapsed(elapsed));
+    }
+    parts.join(" · ")
+}
+
+pub fn open_arena(
+    workspace: &mut Workspace,
+    run: Option<String>,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    let existing = workspace.items_of_type::<ArenaView>(cx).next();
+    if let Some(existing) = existing {
+        existing.update(cx, |view, cx| {
+            if run.is_some() {
+                view.selected_run = run.clone();
+            }
+            cx.notify();
+        });
+        workspace.activate_item(&existing, true, true, window, cx);
+        return;
+    }
+    let view = cx.new(|cx| ArenaView::new(run, cx));
+    workspace.add_item_to_active_pane(Box::new(view), None, true, window, cx);
+}
+
+pub struct ArenaView {
+    store: Option<Entity<ArenaStore>>,
+    selected_run: Option<String>,
+    scrolls: HashMap<String, ScrollHandle>,
+    focus_handle: FocusHandle,
+    _observe: Option<gpui::Subscription>,
+}
+
+impl ArenaView {
+    fn new(selected_run: Option<String>, cx: &mut Context<Self>) -> Self {
+        let store = ArenaStore::global(cx);
+        let observe = store.as_ref().map(|store| {
+            cx.observe(store, |this, _, cx| {
+                for handle in this.scrolls.values() {
+                    handle.scroll_to_bottom();
+                }
+                cx.notify();
+            })
+        });
+        Self {
+            store,
+            selected_run,
+            scrolls: HashMap::new(),
+            focus_handle: cx.focus_handle(),
+            _observe: observe,
+        }
+    }
+
+    fn current_run(&self, cx: &App) -> Option<ArenaRun> {
+        let store = self.store.as_ref()?.read(cx);
+        self.selected_run
+            .as_ref()
+            .and_then(|id| store.runs.iter().find(|run| &run.id == id))
+            .or_else(|| store.runs.first())
+            .cloned()
+    }
+
+    fn render_run_tabs(&self, current: Option<&str>, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = cx.theme().colors().clone();
+        let runs: Vec<ArenaRun> = self
+            .store
+            .as_ref()
+            .map(|store| store.read(cx).runs.iter().take(RUN_TABS).cloned().collect())
+            .unwrap_or_default();
+        let store = self.store.clone();
+        h_flex()
+            .w_full()
+            .flex_wrap()
+            .gap_2()
+            .px_2()
+            .py_1()
+            .border_b_1()
+            .border_color(colors.border)
+            .bg(colors.toolbar_background)
+            .children(runs.into_iter().enumerate().map(|(index, run)| {
+                let selected = current == Some(run.id.as_str());
+                let mut row = h_flex()
+                    .id(("arena-run", index))
+                    .gap_1()
+                    .px_1p5()
+                    .py_0p5()
+                    .rounded_sm()
+                    .cursor_pointer()
+                    .when(selected, |el| el.bg(colors.element_selected))
+                    .child(
+                        Label::new(run.id.split("__").last().unwrap_or(&run.id).to_string())
+                            .size(LabelSize::Small)
+                            .color(if selected { Color::Default } else { Color::Muted }),
+                    );
+                for entry in &run.entries {
+                    let (state, seen) = store
+                        .as_ref()
+                        .map(|s| (s.read(cx).state_of(entry), s.read(cx).is_seen(entry)))
+                        .unwrap_or((ArenaState::Waiting, false));
+                    let (color, glyph) = dot(state, seen, cx);
+                    row = row.child(
+                        h_flex()
+                            .gap_0p5()
+                            .child(div().text_color(color).text_xs().child(glyph))
+                            .child(
+                                Label::new(entry.label.clone())
+                                    .size(LabelSize::XSmall)
+                                    .color(Color::Muted),
+                            ),
+                    );
+                }
+                let id = run.id.clone();
+                row.on_click(cx.listener(move |this, _, _, cx| {
+                    this.selected_run = Some(id.clone());
+                    cx.notify();
+                }))
+            }))
+    }
+
+    fn render_column(&mut self, entry: &ArenaEntry, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = cx.theme().colors().clone();
+        let (state, seen) = self
+            .store
+            .as_ref()
+            .map(|s| (s.read(cx).state_of(entry), s.read(cx).is_seen(entry)))
+            .unwrap_or((ArenaState::Waiting, false));
+        let (color, glyph) = dot(state, seen, cx);
+        let mut header = vec![entry_summary(entry, state)];
+        if let Some(speed) = entry.tok_per_sec {
+            header.push(format!("{speed:.1}tok/s"));
+        }
+        let text = entry
+            .live
+            .as_ref()
+            .map(|path| model::tail(path, LIVE_TAIL_BYTES))
+            .unwrap_or_default();
+        let scroll = self
+            .scrolls
+            .entry(format!("{}::{}", entry.run, entry.label))
+            .or_default()
+            .clone();
+        let buffer_font = ThemeSettings::get_global(cx).buffer_font.family.clone();
+        v_flex()
+            .flex_1()
+            .min_w(px(220.))
+            .h_full()
+            .border_r_1()
+            .border_color(colors.border)
+            .child(
+                h_flex()
+                    .gap_1p5()
+                    .px_2()
+                    .py_1()
+                    .border_b_1()
+                    .border_color(colors.border)
+                    .bg(colors.toolbar_background)
+                    .child(div().text_color(color).child(glyph))
+                    .child(Label::new(entry.label.clone()).size(LabelSize::Small))
+                    .child(
+                        Label::new(header.join(" · "))
+                            .size(LabelSize::XSmall)
+                            .color(Color::Muted),
+                    ),
+            )
+            .child(
+                div()
+                    .id(SharedString::from(format!("arena-live-{}-{}", entry.run, entry.label)))
+                    .flex_1()
+                    .p_2()
+                    .overflow_y_scroll()
+                    .track_scroll(&scroll)
+                    .font_family(buffer_font)
+                    .text_xs()
+                    .text_color(colors.text)
+                    .child(if text.is_empty() {
+                        match state {
+                            ArenaState::Waiting => "앞 모델이 끝나기를 기다리는 중".to_string(),
+                            _ => "(아직 출력 없음)".to_string(),
+                        }
+                    } else {
+                        text
+                    }),
+            )
+    }
+}
+
+impl EventEmitter<()> for ArenaView {}
+
+impl Focusable for ArenaView {
+    fn focus_handle(&self, _: &App) -> FocusHandle {
+        self.focus_handle.clone()
+    }
+}
+
+impl Item for ArenaView {
+    type Event = ();
+
+    fn tab_content_text(&self, _detail: usize, _cx: &App) -> SharedString {
+        "코드 아레나".into()
+    }
+
+    fn tab_icon(&self, _: &Window, _: &App) -> Option<Icon> {
+        Some(Icon::new(IconName::Code))
+    }
+}
+
+impl Render for ArenaView {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let run = self.current_run(cx);
+        if let (Some(run), Some(store)) = (&run, &self.store) {
+            let changed = store.update(cx, |store, _| store.mark_run_seen(run));
+            if changed {
+                cx.notify();
+            }
+        }
+        let colors = cx.theme().colors().clone();
+        let tabs = self
+            .render_run_tabs(run.as_ref().map(|r| r.id.as_str()), cx)
+            .into_any_element();
+        let body = match &run {
+            None => div()
+                .p_4()
+                .child(
+                    Label::new("최근 24시간 아레나 실행이 없습니다 (~/.harness/arena)")
+                        .color(Color::Muted),
+                )
+                .into_any_element(),
+            Some(run) => {
+                let mut columns = Vec::new();
+                for entry in &run.entries {
+                    columns.push(self.render_column(entry, cx).into_any_element());
+                }
+                h_flex()
+                    .flex_1()
+                    .w_full()
+                    .items_start()
+                    .overflow_hidden()
+                    .children(columns)
+                    .into_any_element()
+            }
+        };
+        v_flex()
+            .size_full()
+            .track_focus(&self.focus_handle)
+            .bg(colors.editor_background)
+            .child(tabs)
+            .child(body)
+    }
+}
+
+pub fn init(cx: &mut App) {
+    let store = cx.new(|cx| {
+        let poll = cx.spawn(async move |this, cx| {
+            loop {
+                let runs = cx
+                    .background_spawn(async move {
+                        arena_root()
+                            .map(|root| model::load_runs(&root, now_secs(), MAX_AGE_SECS))
+                            .unwrap_or_default()
+                    })
+                    .await;
+                let alive = this.update(cx, |store: &mut ArenaStore, cx| {
+                    let running = runs
+                        .iter()
+                        .flat_map(|run| &run.entries)
+                        .any(|entry| entry.state == "running");
+                    if store.runs != runs || running {
+                        store.runs = runs;
+                        cx.notify();
+                    }
+                });
+                if alive.is_err() {
+                    break;
+                }
+                cx.background_executor().timer(POLL).await;
+            }
+        });
+        ArenaStore {
+            runs: Vec::new(),
+            seen: HashSet::new(),
+            _poll: poll,
+        }
+    });
+    cx.set_global(GlobalArenaStore(store));
+    cx.observe_new(|workspace: &mut Workspace, _, _| {
+        workspace.register_action(|workspace, _: &OpenArena, window, cx| {
+            open_arena(workspace, None, window, cx);
+        });
+    })
+    .detach();
+}
diff --git a/crates/arena_view/src/model.rs b/crates/arena_view/src/model.rs
new file mode 100644
index 0000000..4ef9d7c
--- /dev/null
+++ b/crates/arena_view/src/model.rs
@@ -0,0 +1,243 @@
+use std::collections::BTreeMap;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+
+use serde_json::Value;
+
+pub const STALL_SECS: f64 = 60.;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ArenaState {
+    Waiting,
+    Running,
+    Done,
+    Failed,
+    Stalled,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ArenaEntry {
+    pub run: String,
+    pub label: String,
+    pub model: String,
+    pub role: String,
+    pub state: String,
+    pub started: Option<f64>,
+    pub ended: Option<f64>,
+    pub tokens: u64,
+    pub tok_per_sec: Option<f64>,
+    pub live: Option<PathBuf>,
+    pub session: Option<String>,
+    pub pid: Option<u32>,
+    pub updated: f64,
+}
+
+impl ArenaEntry {
+    pub fn from_value(value: &Value) -> Option<Self> {
+        let text = |key: &str| value[key].as_str().map(str::to_string);
+        Some(Self {
+            run: text("run")?,
+            label: text("label")?,
+            model: text("model").unwrap_or_default(),
+            role: text("role").unwrap_or_default(),
+            state: text("state").unwrap_or_else(|| "waiting".into()),
+            started: value["started"].as_f64(),
+            ended: value["ended"].as_f64(),
+            tokens: value["tokens"].as_u64().unwrap_or(0),
+            tok_per_sec: value["tok_per_sec"].as_f64(),
+            live: text("live").map(PathBuf::from),
+            session: text("session"),
+            pid: value["pid"].as_u64().map(|pid| pid as u32),
+            updated: value["updated"].as_f64().unwrap_or(0.),
+        })
+    }
+
+    pub fn effective_state(&self, now: f64, pid_alive: impl Fn(u32) -> bool) -> ArenaState {
+        match self.state.as_str() {
+            "done" => ArenaState::Done,
+            "failed" => ArenaState::Failed,
+            state => {
+                let quiet = now - self.updated > STALL_SECS;
+                let dead = self.pid.is_some_and(|pid| !pid_alive(pid));
+                if quiet && dead {
+                    ArenaState::Stalled
+                } else if state == "running" {
+                    ArenaState::Running
+                } else {
+                    ArenaState::Waiting
+                }
+            }
+        }
+    }
+
+    pub fn elapsed(&self, now: f64) -> Option<f64> {
+        let started = self.started?;
+        Some((self.ended.unwrap_or(now) - started).max(0.))
+    }
+
+    pub fn role_label(&self) -> &str {
+        match self.role.as_str() {
+            "candidate" => "후보",
+            "detail" => "보강",
+            "base" => "기반",
+            other => other,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ArenaRun {
+    pub id: String,
+    pub entries: Vec<ArenaEntry>,
+    pub updated: f64,
+}
+
+impl ArenaRun {
+    pub fn session(&self) -> Option<&str> {
+        self.entries.iter().find_map(|entry| entry.session.as_deref())
+    }
+}
+
+pub fn load_runs(root: &Path, now: f64, max_age_secs: f64) -> Vec<ArenaRun> {
+    let Ok(dirs) = std::fs::read_dir(root) else {
+        return Vec::new();
+    };
+    let mut runs = Vec::new();
+    for dir in dirs.flatten() {
+        let path = dir.path();
+        if !path.is_dir() {
+            continue;
+        }
+        let mut entries: BTreeMap<String, ArenaEntry> = BTreeMap::new();
+        let Ok(files) = std::fs::read_dir(&path) else {
+            continue;
+        };
+        for file in files.flatten() {
+            let file = file.path();
+            if file.extension().and_then(|ext| ext.to_str()) != Some("json") {
+                continue;
+            }
+            let Some(entry) = std::fs::read_to_string(&file)
+                .ok()
+                .and_then(|text| serde_json::from_str::<Value>(&text).ok())
+                .and_then(|value| ArenaEntry::from_value(&value))
+            else {
+                continue;
+            };
+            entries.insert(entry.label.clone(), entry);
+        }
+        let mut entries: Vec<ArenaEntry> = entries.into_values().collect();
+        if entries.is_empty() {
+            continue;
+        }
+        entries.sort_by(|a, b| {
+            a.started
+                .unwrap_or(f64::MAX)
+                .total_cmp(&b.started.unwrap_or(f64::MAX))
+                .then_with(|| a.label.cmp(&b.label))
+        });
+        let updated = entries.iter().map(|e| e.updated).fold(0., f64::max);
+        if now - updated > max_age_secs {
+            continue;
+        }
+        runs.push(ArenaRun {
+            id: entries[0].run.clone(),
+            entries,
+            updated,
+        });
+    }
+    runs.sort_by(|a, b| b.updated.total_cmp(&a.updated));
+    runs
+}
+
+pub fn tail(path: &Path, max_bytes: u64) -> String {
+    let Ok(mut file) = std::fs::File::open(path) else {
+        return String::new();
+    };
+    let len = file.metadata().map(|meta| meta.len()).unwrap_or(0);
+    let start = len.saturating_sub(max_bytes);
+    if file.seek(SeekFrom::Start(start)).is_err() {
+        return String::new();
+    }
+    let mut bytes = Vec::new();
+    if file.read_to_end(&mut bytes).is_err() {
+        return String::new();
+    }
+    let text = String::from_utf8_lossy(&bytes).into_owned();
+    if start == 0 {
+        return text;
+    }
+    match text.find('\n') {
+        Some(newline) => text[newline + 1..].to_string(),
+        None => text,
+    }
+}
+
+pub fn format_elapsed(seconds: f64) -> String {
+    let seconds = seconds as u64;
+    if seconds < 60 {
+        format!("{seconds}s")
+    } else if seconds < 3600 {
+        format!("{}m{:02}s", seconds / 60, seconds % 60)
+    } else {
+        format!("{}h{:02}m", seconds / 3600, (seconds % 3600) / 60)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn write(dir: &Path, run: &str, label: &str, json: &str) {
+        let path = dir.join(run);
+        std::fs::create_dir_all(&path).unwrap();
+        std::fs::write(path.join(format!("{label}.json")), json).unwrap();
+    }
+
+    #[test]
+    fn loads_runs_newest_first_and_skips_old() {
+        let dir = tempfile::tempdir().unwrap();
+        write(dir.path(), "a", "qwen", r#"{"run":"a","label":"qwen","role":"candidate","state":"done","started":10,"ended":40,"tokens":300,"updated":40}"#);
+        write(dir.path(), "a", "devstral", r#"{"run":"a","label":"devstral","role":"candidate","state":"running","started":20,"tokens":120,"updated":90,"session":"s1"}"#);
+        write(dir.path(), "b", "qwen", r#"{"run":"b","label":"qwen","state":"waiting","updated":95}"#);
+        write(dir.path(), "old", "qwen", r#"{"run":"old","label":"qwen","state":"done","updated":1}"#);
+        std::fs::write(dir.path().join("a").join("qwen.live.txt"), "x").unwrap();
+        let runs = load_runs(dir.path(), 100., 50.);
+        assert_eq!(runs.iter().map(|r| r.id.as_str()).collect::<Vec<_>>(), ["b", "a"]);
+        let a = &runs[1];
+        assert_eq!(a.entries.iter().map(|e| e.label.as_str()).collect::<Vec<_>>(), ["qwen", "devstral"]);
+        assert_eq!(a.session(), Some("s1"));
+        assert_eq!(a.entries[0].elapsed(100.), Some(30.));
+        assert_eq!(a.entries[1].elapsed(100.), Some(80.));
+        assert_eq!(a.entries[0].role_label(), "후보");
+    }
+
+    #[test]
+    fn stalled_needs_quiet_and_dead_pid() {
+        let value: Value = serde_json::from_str(
+            r#"{"run":"a","label":"q","state":"running","pid":42,"updated":0}"#,
+        )
+        .unwrap();
+        let entry = ArenaEntry::from_value(&value).unwrap();
+        assert_eq!(entry.effective_state(30., |_| false), ArenaState::Running);
+        assert_eq!(entry.effective_state(100., |_| true), ArenaState::Running);
+        assert_eq!(entry.effective_state(100., |_| false), ArenaState::Stalled);
+    }
+
+    #[test]
+    fn tail_starts_at_a_line_boundary() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("live.txt");
+        std::fs::write(&path, "첫째 줄\n둘째 줄\n셋째").unwrap();
+        assert_eq!(tail(&path, 1000), "첫째 줄\n둘째 줄\n셋째");
+        assert_eq!(tail(&path, 12), "셋째");
+        assert_eq!(tail(&dir.path().join("none"), 10), "");
+    }
+
+    #[test]
+    fn elapsed_format() {
+        assert_eq!(format_elapsed(32.), "32s");
+        assert_eq!(format_elapsed(125.), "2m05s");
+        assert_eq!(format_elapsed(3720.), "1h02m");
+    }
+}
