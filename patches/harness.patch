+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    std::fs::write(path, CANVAS_TEMPLATE)
+}
+
+const USAGE_POLL: Duration = Duration::from_secs(30);
