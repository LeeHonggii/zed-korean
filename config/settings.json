// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  // 애플 다크풍 중성 검정 — One Dark의 파란빛 회색 제거
  "experimental.theme_overrides": {
    "background": "#000000",
    "editor.background": "#0a0a0a",
    "editor.gutter.background": "#0a0a0a",
    "surface.background": "#141414",
    "elevated_surface.background": "#1c1c1c",
    "panel.background": "#0d0d0d",
    "status_bar.background": "#000000",
    "title_bar.background": "#000000",
    "toolbar.background": "#0a0a0a",
    "tab_bar.background": "#000000",
    "tab.active_background": "#1a1a1a",
    "tab.inactive_background": "#000000",
    "editor.active_line.background": "#161616",
    "border": "#242424",
    "border.variant": "#1a1a1a",
    "scrollbar.track.background": "#0a0a0a"
  },
  "agent_servers": {
    "Claude Code (전체세션)": {
      "type": "custom",
      "command": "node",
      "args": [
        "/Users/lee-hong-gi/Tools/claude-agent-acp/dist/index.js"
      ],
      "env": {
        "CLAUDE_ACP_ALL_SESSIONS": "1",
        "CLAUDE_ACP_HIDE_AUTOMATION": "1"
      }
    }
  },
}
